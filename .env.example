PORT=3000

# From Google Cloud Console > APIs & Services > Credentials (OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" configured on the OAuth client
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Shopify custom/private app Admin API access token, needs the read_orders scope
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-10

# Used to draft AI-generated reply suggestions (never sent automatically)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Gmail label used to mark inbound messages that already have a draft, so they aren't re-processed
GMAIL_DRAFT_LABEL=AI-Drafted
GMAIL_HUMAN_REVIEW_LABEL=Needs-Human-Review

# Background scheduler: automatically scans every connected inbox on a timer.
# Set to false to only run it on-demand via POST /automation/draft-replies.
AUTOMATION_ENABLED=true
AUTOMATION_INTERVAL_MINUTES=5
