{%- comment -%}
  SHOKOGI — Home, scroll-craft build. White + Shokogi pink + a touch of black.
  Barlow Condensed + Figtree. The hero text sits BELOW the video (never on it).
  Signature "tide": foam line under the hero, a wave that washes up at the foil peak.
  Design-only rework of the live home page — every word, link and image is preserved.
{%- endcomment -%}
{{ 'sc.css' | asset_url | stylesheet_tag }}
{{ 'sc2.css' | asset_url | stylesheet_tag }}
<noscript><style>.scp [data-sc-in]>*,.scp .k-i{opacity:1!important;transform:none!important}.scp .peak .pwash{transform:translateY(40%)}</style></noscript>
{%- assign hv = section.settings.hero_video -%}
<div class="scp" data-sc-root>

  <!-- HERO — real video, tide foam at the shoreline, headline below -->
  <header class="hero">
    <div class="vid">
      <video autoplay muted loop playsinline preload="auto"{% if hv != blank and hv.preview_image %} poster="{{ hv.preview_image | image_url: width: 1600 }}"{% endif %}>
        {%- if hv != blank and hv.sources.size > 0 -%}
          {%- for src in hv.sources -%}{%- if src.format == 'mp4' -%}<source src="{{ src.url }}" type="video/mp4">{%- endif -%}{%- endfor -%}
        {%- else -%}
          <source src="https://cdn.shopify.com/videos/c/vp/793b1b1551b44fa780fee83e10adf241/793b1b1551b44fa780fee83e10adf241.HD-720p-4.5Mbps-22536222.mp4" type="video/mp4">
        {%- endif -%}
      </video>
    </div>
    <div class="tide" aria-hidden="true"><i class="w1"></i><i class="w2"></i></div>
  </header>
  <div class="herotext">
    <span class="eyebrow heroeb">Playa Venao &middot; Panama</span>
    <h1 data-sc-kinetic>World-Class Surf Lessons, Camps &amp; Foil Surfing in Playa Venao</h1>
    <div class="herosub" data-sc-in data-sc-stagger="90">
      <p>Lessons, Camps, Foil Surfing, and More &mdash; all steps from the waves in Playa Venao.</p>
      <div class="cta"><a href="/collections/surf-school-and-courses" class="btn">Book Now</a></div>
    </div>
  </div>

  <!-- STATS — open hairline strip -->
  <div class="sec sec--tight"><div class="wrap">
    <div class="stats" data-sc-in data-sc-stagger="90">
      <div class="stat"><b>Playa&nbsp;Venao</b><span>Panama &middot; Pacific coast</span></div>
      <div class="stat"><b>All&nbsp;year</b><span>Waves every season</span></div>
      <div class="stat"><b>All&nbsp;levels</b><span>First wave to advanced</span></div>
      <div class="stat"><b>100+</b><span>Boards &middot; every size on hand</span></div>
    </div>
  </div></div>

  <!-- INTRO -->
  <div class="sec intro"><div class="wrap">
    <div data-sc-in data-sc-stagger="90">
      <span class="eyebrow">surf school</span>
      <h2>Your Panama Surf Adventure Awaits</h2>
      <p>Whether you&rsquo;re catching your very first wave or leveling up your surf skills, our experienced instructors have you covered. Choose from personalized surf lessons, immersive surf camps, foil surfing adventures, and engaging kids&rsquo; summer camps. With perfect waves, quality surfboard rentals, and our own Ocean Monkey soft-top boards, Shokogi is your ultimate Panama surf destination. Come join our vibrant surf community and experience the magic of Playa Venao!</p>
      <a href="/collections/surf-school-and-courses" class="btn">Join Us</a>
    </div>
  </div></div>

  <!-- PROGRAMMES — a horizontal rail you pan through while the frame holds still -->
  <section class="ways" data-sc-act="pan" data-sc-span="2.4" aria-label="What we offer">
    <div class="stage">
      <div class="rail" data-sc-pan>
        <div class="lead">
          <span class="eyebrow">what we offer</span>
          <h2>Find your<br>perfect wave</h2>
          <p>Lessons, foil, custom trips, kids&rsquo; camps &mdash; keep scrolling to move along the lineup.</p>
        </div>
        <a href="/collections/surf-school-and-courses" class="prog">
          <div class="ph">{%- if section.settings.pgm_surf -%}{{ section.settings.pgm_surf | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(max-width:700px) 78vw, 21rem', alt: 'Surf Lessons & Camps in Playa Venao' }}{%- endif -%}</div>
          <div class="pc"><span class="k">Surf</span><h3>Surf Lessons &amp; Camps in Playa Venao</h3><p>Learn to surf or level up your skills with expert-led lessons and all-inclusive surf camps in Panama&rsquo;s top surf spot.</p><span class="more">Book now &rarr;</span></div>
        </a>
        <a href="/collections/foil-surfing" class="prog">
          <div class="ph">{%- if section.settings.pgm_foil -%}{{ section.settings.pgm_foil | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(max-width:700px) 78vw, 21rem', alt: 'Foil Surfing in Playa Venao' }}{%- endif -%}</div>
          <div class="pc"><span class="k">Foil</span><h3>Foil Surfing in Playa Venao</h3><p>Discover the thrill of foil surfing in Panama. Book a private lesson and glide above the waves with our certified instructors.</p><span class="more">Fly now &rarr;</span></div>
        </a>
        <a href="/pages/custom-trips" class="prog">
          <div class="ph">{%- if section.settings.pgm_trips -%}{{ section.settings.pgm_trips | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(max-width:700px) 78vw, 21rem', alt: 'Custom Surf Trips in Playa Venao' }}{%- endif -%}</div>
          <div class="pc"><span class="k">Custom Trips</span><h3>Custom Surf Trips in Playa Venao</h3><p>Choose your length of stay, pick your accommodations, and enjoy surf lessons and board rentals included. Perfectly tailored Panama surf packages for every traveler.</p><span class="more">Book now &rarr;</span></div>
        </a>
        <a href="/collections/kids-summer-camp-panama" class="prog">
          <div class="ph">{%- if section.settings.pgm_kids -%}{{ section.settings.pgm_kids | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(max-width:700px) 78vw, 21rem', alt: 'Kids Camp in Playa Venao' }}{%- endif -%}</div>
          <div class="pc"><span class="k">Kids</span><h3>Kids Camp in Playa Venao</h3><p>Safe, fun, and skill-building surf camps for kids. Ideal for young kids and teens, with lessons, games, and ocean education.</p><span class="more">Book now &rarr;</span></div>
        </a>
      </div>
    </div>
  </section>

  {%- render 'schome-rest', foil_video: section.settings.foil_video, rentals_image: section.settings.rentals_image -%}

</div>

<script src="{{ 'sc.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Home Page",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Hero video" },
    { "type": "video", "id": "hero_video", "label": "Hero video" },
    { "type": "header", "content": "Foil video" },
    { "type": "video", "id": "foil_video", "label": "Foil video" },
    { "type": "header", "content": "Programme images" },
    { "type": "image_picker", "id": "pgm_surf", "label": "Surf" },
    { "type": "image_picker", "id": "pgm_foil", "label": "Foil" },
    { "type": "image_picker", "id": "pgm_trips", "label": "Custom Trips" },
    { "type": "image_picker", "id": "pgm_kids", "label": "Kids" },
    { "type": "header", "content": "Rentals" },
    { "type": "image_picker", "id": "rentals_image", "label": "Rentals image" }
  ],
  "presets": [ { "name": "Home Page" } ]
}
{% endschema %}
