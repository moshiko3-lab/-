{%- comment -%} SHOKOGI Foil Retreat Panama — PART 1 (before the equipment animation): hero, overview, foil in action, why Playa Venao, daily schedule. Surf Camp design. {%- endcomment -%}
{{ 'sk.css' | asset_url | stylesheet_tag }}
<style>.skp .vclips{display:grid;grid-template-columns:1fr 1fr;gap:16px;max-width:720px;margin:0 auto}.skp .vclips video{width:100%;aspect-ratio:9/16;object-fit:cover;border-radius:16px;background:#000;display:block}@media(max-width:600px){.skp .vclips{gap:10px}}
@media(max-width:760px){.skp .sec{content-visibility:auto;contain-intrinsic-size:auto 560px}}
/* Daily schedule: compact pink timeline */
.skp .sched{max-width:560px;margin:clamp(18px,3vw,24px) auto 0;position:relative;padding-left:26px}
.skp .sched::before{content:"";position:absolute;left:5px;top:9px;bottom:9px;width:2px;background:var(--line)}
.skp .sched .srow{display:block;grid-template-columns:none;gap:0;padding:0 0 15px;border-top:0;position:relative}
.skp .sched .srow:last-child{padding-bottom:0}
.skp .sched .srow::before{content:"";position:absolute;left:-26px;top:3px;width:12px;height:12px;border-radius:50%;background:var(--pink);border:2.5px solid var(--bg)}
.skp .sched .srow .st{font-size:14px;letter-spacing:.03em;line-height:1.1;margin-bottom:1px}
.skp .sched .srow h3{font-size:12px;margin:0 0 2px}
.skp .sched .srow p{font-size:12.5px;line-height:1.5}</style>
<div class="skp">
  <!-- HERO (video) -->
  {%- assign hv = section.settings.hero_video -%}
  <div class="herofull"><video class="skvid" muted loop playsinline preload="none"{% if hv != blank and hv.preview_image %} poster="{{ hv.preview_image | image_url: width: 1600 }}"{% endif %}>
    {%- if hv != blank and hv.sources.size > 0 -%}
      {%- for src in hv.sources -%}{%- if src.format == 'mp4' -%}<source src="{{ src.url }}" type="video/mp4">{%- endif -%}{%- endfor -%}
    {%- else -%}
      <source src="https://cdn.shopify.com/videos/c/vp/7bd939476537487f9c7445f02a6bc6ce/7bd939476537487f9c7445f02a6bc6ce.HD-720p-1.6Mbps-48686215.mp4" type="video/mp4">
    {%- endif -%}
  </video></div>
  <div class="herotext">
    <div class="htag">Foil Tow-In Retreat &middot; Playa Venao</div>
    <h1>Foil Retreat Panama</h1>
    <p>An intensive 8-day foil tow-in retreat for experienced foilers ready to ride empty, perfect waves &mdash; with professional jet ski support, drone filming, and video analysis.</p>
    <a href="#retreat-book" class="btn pink">Email Us to Book</a>
  </div>

  <!-- RETREAT OVERVIEW -->
  <div class="sec"><div class="wrap">
    <div class="kicker" style="text-align:center">01 &middot; The Retreat</div>
    <h2>8 Days of Empty, Perfect Waves</h2>
    <div class="facts" style="margin-top:22px">
      <div class="fact"><b>Length</b><span>8 Days, 7 Nights</span></div>
      <div class="fact"><b>Group Size</b><span>Max 4 Foilers</span></div>
      <div class="fact"><b>Sessions</b><span>1&ndash;2 Daily</span></div>
      <div class="fact"><b>Level</b><span>Advanced</span></div>
    </div>
    <div class="story" style="margin-top:28px">
      <p>This intensive retreat in Playa Venao, Panama is designed for experienced foilers eager to ride empty, perfect waves. With only 4 participants, you&rsquo;ll receive personalized coaching and professional jet ski support. Sessions are planned around the tides and conditions, with either two sessions or one extended session.</p>
      <p><strong>2027 Retreat Dates</strong><br/>New dates coming soon.</p>
    </div>
  </div></div>

  <!-- FOIL IN ACTION (2 vertical clips) -->
  <div class="sec"><div class="wrap">
    <div class="kicker" style="text-align:center">Foil in Action</div>
    <div class="vclips" style="margin-top:22px">
      {%- assign cv1 = section.settings.clip_1 -%}
      <video class="skvid" muted loop playsinline preload="none"{% if cv1 != blank and cv1.preview_image %} poster="{{ cv1.preview_image | image_url: width: 900 }}"{% endif %}>
        {%- if cv1 != blank and cv1.sources.size > 0 -%}{%- for src in cv1.sources -%}{%- if src.format == 'mp4' -%}<source src="{{ src.url }}" type="video/mp4">{%- endif -%}{%- endfor -%}{%- else -%}<source src="https://cdn.shopify.com/videos/c/vp/8b82cc6917b04ad5a3742f217a5a215d/8b82cc6917b04ad5a3742f217a5a215d.HD-720p-4.5Mbps-66777386.mp4" type="video/mp4">{%- endif -%}
      </video>
      {%- assign cv2 = section.settings.clip_2 -%}
      <video class="skvid" muted loop playsinline preload="none"{% if cv2 != blank and cv2.preview_image %} poster="{{ cv2.preview_image | image_url: width: 900 }}"{% endif %}>
        {%- if cv2 != blank and cv2.sources.size > 0 -%}{%- for src in cv2.sources -%}{%- if src.format == 'mp4' -%}<source src="{{ src.url }}" type="video/mp4">{%- endif -%}{%- endfor -%}{%- else -%}<source src="https://cdn.shopify.com/videos/c/vp/916db8bd39584dcb84492de30074a96b/916db8bd39584dcb84492de30074a96b.HD-720p-4.5Mbps-66775802.mp4" type="video/mp4">{%- endif -%}
      </video>
    </div>
  </div></div>

  <!-- WHY PLAYA VENAO -->
  <div class="sec tint"><div class="wrap">
    <div class="kicker" style="text-align:center">02 &middot; Why Playa Venao</div>
    <h2>Why Playa Venao for Foil Tow-In Training?</h2>
    {%- assign wv = section.settings.why_video -%}
    <video class="wideimg skvid" muted loop playsinline preload="none" style="height:auto;max-height:520px;aspect-ratio:16/9;object-fit:cover">
      {%- if wv != blank and wv.sources.size > 0 -%}{%- for src in wv.sources -%}{%- if src.format == 'mp4' -%}<source src="{{ src.url }}" type="video/mp4">{%- endif -%}{%- endfor -%}{%- else -%}<source src="https://cdn.shopify.com/videos/c/vp/37216f6105f6476eb886caa3a8420b7a/37216f6105f6476eb886caa3a8420b7a.HD-720p-4.5Mbps-37181063.mp4" type="video/mp4">{%- endif -%}
    </video>
    <div class="story">
      <h3>Multiple Locations, Not One Break</h3>
      <p>Most foil retreats lock you into one break with variable conditions. Playa Venao offers multiple tow-in locations within minutes &mdash; we choose the best spot daily based on swell, wind, and your ability. This flexibility means you&rsquo;re never stuck with poor conditions.</p>
      <h3>Maximum Water Time</h3>
      <p>Our jet ski drivers eliminate positioning guesswork and maximize your wave count. You get dramatically more attempts per session compared to paddling or self-towing. Our drivers are experienced foilers themselves who know these breaks intimately and can coach technique in real-time.</p>
      <h3>World-Class Year-Round Conditions</h3>
      <p>78&ndash;82&deg;F water (no thick wetsuits needed), consistent Pacific swells (never flat), and uncrowded lineups &mdash; often entire sections to yourself. We successfully run retreats 12 months a year, though May&ndash;June offers peak consistency for this program.</p>
    </div>
  </div></div>

  <!-- DAILY SCHEDULE -->
  <div class="sec"><div class="wrap">
    <div class="kicker" style="text-align:center">03 &middot; A Day at the Retreat</div>
    <h2>Your Daily Retreat Schedule</h2>
    <div class="sched">
      <div class="srow"><div class="st">7:00 AM</div><div><h3>Morning Tow-In Session</h3><p>1.5&ndash;2 hours on the water with drone filming.</p></div></div>
      <div class="srow"><div class="st">9:30 AM</div><div><h3>Breakfast &amp; Session Planning</h3><p>Review conditions and plan the day&rsquo;s approach.</p></div></div>
      <div class="srow"><div class="st">11:00 AM</div><div><h3>Free Time</h3><p>Relax, explore, lunch, or free surf.</p></div></div>
      <div class="srow"><div class="st">2:00 PM</div><div><h3>Video Review <span style="color:var(--muted);text-transform:none;letter-spacing:0;font-weight:400">(select days)</span></h3><p>Watch footage, receive coaching, plan improvements.</p></div></div>
      <div class="srow"><div class="st">5:00 PM</div><div><h3>Afternoon Tow-In Session</h3><p>Second 1.5&ndash;2 hour session with a different tide.</p></div></div>
    </div>
  </div></div>
</div>

<script>
/* Each clip loads the first time it scrolls into view (preload="none") and then
   just plays while visible / pauses when off-screen - the decoded buffer is kept. */
(function(){
  if(window.__skVid)return; window.__skVid=1;
  var vids=[].slice.call(document.querySelectorAll('.skp video.skvid'));
  if(!vids.length) return;
  var play=function(v){ try{ var p=v.play(); if(p&&p.catch) p.catch(function(){}); }catch(e){} };
  if(!('IntersectionObserver' in window)){ vids.forEach(play); return; }
  var io=new IntersectionObserver(function(ents){
    ents.forEach(function(e){
      var v=e.target;
      if(e.isIntersecting){ play(v); }
      else if(!v.paused){ v.pause(); }
    });
  }, {rootMargin:'300px 0px', threshold:0.1});
  vids.forEach(function(v){ io.observe(v); });
})();
</script>

