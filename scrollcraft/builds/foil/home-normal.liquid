{%- comment -%} SHOKOGI Home — faithful copy of the live home page content, in the Surf Camp design. {%- endcomment -%}
{{ 'sk.css' | asset_url | stylesheet_tag }}
<div class="skp">
  <!-- HERO (video) -->
  {%- assign hv = section.settings.hero_video -%}
  <div class="herofull"><video autoplay muted loop playsinline preload="auto"{% if hv != blank and hv.preview_image %} poster="{{ hv.preview_image | image_url: width: 1600 }}"{% endif %}>
    {%- if hv != blank and hv.sources.size > 0 -%}
      {%- for src in hv.sources -%}{%- if src.format == 'mp4' -%}<source src="{{ src.url }}" type="video/mp4">{%- endif -%}{%- endfor -%}
    {%- else -%}
      <source src="https://cdn.shopify.com/videos/c/vp/793b1b1551b44fa780fee83e10adf241/793b1b1551b44fa780fee83e10adf241.HD-720p-4.5Mbps-22536222.mp4" type="video/mp4">
    {%- endif -%}
  </video></div>
  <div class="herotext">
    <div class="htag">Playa Venao &middot; Panama</div>
    <h1>World-Class Surf Lessons, Camps &amp; Foil Surfing in Playa Venao</h1>
    <p>Lessons, Camps, Foil Surfing, and More &mdash; all steps from the waves in Playa Venao.</p>
    <a href="/collections/surf-school-and-courses" class="btn pink">Book Now</a>
  </div>

  <!-- STATS -->
  <div class="sec"><div class="wrap">
    <div class="stats">
      <div class="stat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M2 15c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2 2-2 4-2M2 20c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2 2-2 4-2"/></svg><div class="v">Playa Venao</div><div class="l">Panama &middot; Pacific coast</div></div>
      <div class="stat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.4 1.4M17.6 17.6L19 19M19 5l-1.4 1.4M6.4 17.6L5 19"/></svg><div class="v">All year</div><div class="l">Waves every season</div></div>
      <div class="stat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20v-5M10 20v-9M16 20v-13M20 20H3"/></svg><div class="v">All levels</div><div class="l">First wave to advanced</div></div>
      <div class="stat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2c4 3 5 10 2 18-1 2-3 2-4 0C7 12 8 5 12 2z"/><path d="M12 7v9"/></svg><div class="v">100+ Boards</div><div class="l">Every size on hand</div></div>
    </div>
  </div></div>

  <!-- INTRO -->
  <div class="sec tint"><div class="wrap">
    <div class="kicker" style="text-align:center">surf school</div>
    <h2>Your Panama Surf Adventure Awaits</h2>
    <p class="lead" style="margin-bottom:24px">Whether you&rsquo;re catching your very first wave or leveling up your surf skills, our experienced instructors have you covered. Choose from personalized surf lessons, immersive surf camps, foil surfing adventures, and engaging kids&rsquo; summer camps. With perfect waves, quality surfboard rentals, and our own Ocean Monkey soft-top boards, Shokogi is your ultimate Panama surf destination. Come join our vibrant surf community and experience the magic of Playa Venao!</p>
    <div style="text-align:center"><a href="/collections/surf-school-and-courses" class="btn pink">Join Us</a></div>
  </div></div>

  <!-- PROGRAMMES -->
  <div class="sec"><div class="wrap">
    <div class="kicker" style="text-align:center">what we offer</div>
    <h2>Find Your Perfect Surf Experience</h2>
    <div class="pgm" style="margin-top:26px">
      <a href="/collections/surf-school-and-courses" class="icard">
        {%- if section.settings.pgm_surf -%}{{ section.settings.pgm_surf | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', alt: 'Surf Lessons & Camps in Playa Venao' }}{%- endif -%}
        <div class="ib"><div class="k">Surf</div><h3>Surf Lessons &amp; Camps in Playa Venao</h3><p>Learn to surf or level up your skills with expert-led lessons and all-inclusive surf camps in Panama&rsquo;s top surf spot.</p><span class="more">Book now &rarr;</span></div>
      </a>
      <a href="/collections/foil-surfing" class="icard">
        {%- if section.settings.pgm_foil -%}{{ section.settings.pgm_foil | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', alt: 'Foil Surfing in Playa Venao' }}{%- endif -%}
        <div class="ib"><div class="k">Foil</div><h3>Foil Surfing in Playa Venao</h3><p>Discover the thrill of foil surfing in Panama. Book a private lesson and glide above the waves with our certified instructors.</p><span class="more">Fly now &rarr;</span></div>
      </a>
      <a href="/pages/custom-trips" class="icard">
        {%- if section.settings.pgm_trips -%}{{ section.settings.pgm_trips | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', alt: 'Custom Surf Trips in Playa Venao' }}{%- endif -%}
        <div class="ib"><div class="k">Custom Trips</div><h3>Custom Surf Trips in Playa Venao</h3><p>Choose your length of stay, pick your accommodations, and enjoy surf lessons and board rentals included. Perfectly tailored Panama surf packages for every traveler.</p><span class="more">Book now &rarr;</span></div>
      </a>
      <a href="/collections/kids-summer-camp-panama" class="icard">
        {%- if section.settings.pgm_kids -%}{{ section.settings.pgm_kids | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', alt: 'Kids Camp in Playa Venao' }}{%- endif -%}
        <div class="ib"><div class="k">Kids</div><h3>Kids Camp in Playa Venao</h3><p>Safe, fun, and skill-building surf camps for kids. Ideal for young kids and teens, with lessons, games, and ocean education.</p><span class="more">Book now &rarr;</span></div>
      </a>
    </div>
  </div></div>

  <!-- TESTIMONIALS -->
  <div class="sec tint"><div class="wrap">
    <div class="kicker" style="text-align:center">testimonials</div>
    <h2>Why Surfers Love Shokogi</h2>
    <div class="revs">
      <div class="rev"><div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div><p>This is without a doubt the best surf shop ever - the location itself is just AMAZING - but the staff who work there are even more amazing.</p><div class="who">Charles <span>&middot; Canada</span></div></div>
      <div class="rev"><div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div><p>Our 4.5 years old participated in Shokogi&rsquo;s surf camp during Christmas break. Within 4-5 days he was SURFING!</p><div class="who">Noa <span>&middot; USA</span></div></div>
      <div class="rev"><div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div><p>Had an amazing experience at Shokogi! The surf lessons were excellent&mdash;great instructors who really know their stuff when it comes to surfing and bring so much heart and energy to every lesson.</p><div class="who">Eden <span>&middot; Israel</span></div></div>
      <div class="rev"><div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div><p>Where friends become family. It was my first time surfing, and I loved every second of it, yes even the crashing. The team welcomes you with open arms. For me it felt like coming home!</p><div class="who">Eline <span>&middot; Belgium</span></div></div>
    </div>
  </div></div>

  <!-- FOIL VIDEO BANNER -->
  <div class="sec"><div class="wrap">
    <div class="kicker" style="text-align:center">Glide Above the Waves</div>
    <h2>Foil Surf Lessons in Playa Venao</h2>
    <p class="lead" style="margin-bottom:24px">Learn to foil surf with expert instructors in perfect conditions. Safe, fun, and beginner-friendly.</p>
    <div style="text-align:center"><a href="/collections/foil-surfing" class="btn pink">Fly Now</a></div>
  </div></div>
  {%- assign fv = section.settings.foil_video -%}
  <div class="videofull"><video autoplay muted loop playsinline preload="metadata"{% if fv != blank and fv.preview_image %} poster="{{ fv.preview_image | image_url: width: 1600 }}"{% endif %}>
    {%- if fv != blank and fv.sources.size > 0 -%}
      {%- for src in fv.sources -%}{%- if src.format == 'mp4' -%}<source src="{{ src.url }}" type="video/mp4">{%- endif -%}{%- endfor -%}
    {%- else -%}
      <source src="https://cdn.shopify.com/videos/c/vp/edff47b97c4446f880778bb32dd26bca/edff47b97c4446f880778bb32dd26bca.HD-720p-4.5Mbps-48918163.mp4" type="video/mp4">
    {%- endif -%}
  </video></div>

  <!-- SHOP BRAND -->
  <div class="sec"><div class="wrap">
    <div class="kicker" style="text-align:center">shop</div>
    <h2>Gear Up with Shokogi</h2>
    <p class="lead">Represent Shokogi from all around the world and share the surf culture with family and friends. From stylish apparel to must-have surf gear &mdash; whether you need sun protection or new surf apparel, we&rsquo;ve got the essentials for every surfer.</p>
    <div class="pgrid">
      {%- assign brandcol = collections['shokogi-brand'] -%}
      {%- for product in brandcol.products limit: 8 -%}
      <a href="{{ product.url }}" class="pcard">
        {%- if product.featured_image -%}{{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', alt: product.title }}{%- endif -%}
        <div class="pcard-b">
          <h3>{{ product.title }}</h3>
          <div class="pprice">{{ product.price | money_without_trailing_zeros }}</div>
          <span class="pbtn">View</span>
        </div>
      </a>
      {%- endfor -%}
    </div>
    <div style="text-align:center;margin-top:30px"><a href="/collections/shokogi-brand" class="btn pink">Shop Now</a></div>
  </div></div>

  <!-- RENTALS -->
  <div class="sec tint"><div class="wrap">
    <div class="band rev">
      {%- if section.settings.rentals_image -%}<img src="{{ section.settings.rentals_image | image_url: width: 1200 }}" alt="Surf Board Rentals in Playa Venao" loading="lazy">{%- endif -%}
      <div class="bt">
        <div class="kicker">rentals</div>
        <h2>Surf Board Rentals in Playa Venao</h2>
        <p>Traveling light or trying something new? Shokogi offers high-quality surfboard rentals, including shortboards, longboards, and our beginner-friendly Ocean Monkey soft-top boards. Grab a board, hit the waves, and experience Panama surf at your own pace.</p>
        <a href="/collections/surfboard-rental-panama" class="btn pink">Rent Today</a>
      </div>
    </div>
  </div></div>

  <!-- JOURNAL -->
  <div class="sec"><div class="wrap">
    <div class="kicker" style="text-align:center">surf journal</div>
    <h2>Latest Articles</h2>
    <div class="bgrid" style="margin-top:26px">
      {%- assign blog = blogs['surf-blog'] -%}
      {%- for article in blog.articles limit: 4 -%}
      <a href="{{ article.url }}" class="icard">
        {%- if article.image -%}{{ article.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300,500,700', alt: article.title }}{%- endif -%}
        <div class="ib"><div class="k">{{ article.published_at | date: '%b %d, %Y' }}</div><h3>{{ article.title }}</h3></div>
      </a>
      {%- endfor -%}
    </div>
    <div style="text-align:center;margin-top:30px"><a href="/blogs/surf-blog" class="btn pink">Read the Blog</a></div>
  </div></div>

  <!-- CLOSER -->
  <div class="sec tint"><div class="wrap closer">
    <h2>Come surf with us in Playa Venao</h2>
    <p>Lessons, camps, foil, and rentals &mdash; all steps from the waves. Join the Shokogi surf family.</p>
    <a href="/collections/surf-school-and-courses" class="btn pink">Book Now</a>
  </div></div>
</div>

{% schema %}
{
  "name": "Home Page",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Hero video" },
    { "type": "video", "id": "hero_video", "label": "Hero video" },
    { "type": "header", "content": "Foil video" },
    { "type": "video", "id": "foil_video", "label": "Foil video" },
    { "type": "header", "content": "Programme images" },
    { "type": "image_picker", "id": "pgm_surf", "label": "Surf" },
    { "type": "image_picker", "id": "pgm_foil", "label": "Foil" },
    { "type": "image_picker", "id": "pgm_trips", "label": "Custom Trips" },
    { "type": "image_picker", "id": "pgm_kids", "label": "Kids" },
    { "type": "header", "content": "Rentals" },
    { "type": "image_picker", "id": "rentals_image", "label": "Rentals image" }
  ],
  "presets": [ { "name": "Home Page" } ]
}
{% endschema %}
