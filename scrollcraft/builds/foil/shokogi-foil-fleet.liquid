    { "type": "text", "id": "cap_1", "label": "Step 1", "default": "Tow pylon drops onto the rear deck" },
    { "type": "text", "id": "cap_2", "label": "Step 2", "default": "Rope ties to the top of the pylon" },
    { "type": "text", "id": "cap_3", "label": "Step 3", "default": "Sled settles onto the stern" },
    { "type": "text", "id": "cap_4", "label": "Step 4", "default": "Floats hug the hull sides" },
    { "type": "text", "id": "cap_5", "label": "Running", "default": "Running. Hold the throttle." },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "btn_replay", "label": "Replay", "default": "Replay" },
    { "type": "text", "id": "btn_gas", "label": "Throttle", "default": "Throttle" },
    { "type": "text", "id": "btn_sound_on", "label": "Sound on", "default": "Sound on" },
