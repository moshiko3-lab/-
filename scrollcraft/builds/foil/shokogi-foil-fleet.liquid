    { "type": "textarea", "id": "lede", "label": "Intro", "default": "Each piece on its own — then scroll, and watch them lock onto the ski, fire up, and throw water." },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#f46e95" },
    { "type": "select", "id": "default_model", "label": "Default model", "default": "wake",
      "options": [ { "value": "wake", "label": "Wake Pro" }, { "value": "gtx", "label": "GTX Limited" } ] },
