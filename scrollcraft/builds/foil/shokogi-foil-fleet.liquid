{%- comment -%}
  SHOKOGI foil — "Your tow-in setup, part by part".
  Owner-built scroll-driven assembly (another session), rebuilt into a Shopify
  section: English, Shokogi style (pink accent, Barlow Condensed + Figtree),
  compact. Each piece is shown on its own, then a pinned stage assembles the rig
  onto the Sea-Doo AS YOU SCROLL, the engine fires, water jets. Falls back to a
  self-playing block where the page can't scroll (prefers-reduced-motion safe).
  This is the only section on the two foil pages that loads sk.css + the foil
  polish + the brand fonts, so the whole page keeps its polish. Images on Files.
{%- endcomment -%}
{{ 'sk.css' | asset_url | stylesheet_tag }}
{{ 'skplusfoil.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Figtree:wght@400;500;600;700&display=swap">

{%- assign B = 'https://cdn.shopify.com/s/files/1/0116/5364/4354/files/' -%}
{%- assign V1 = '?v=1792879218' -%}
{%- assign V2 = '?v=1792881173' -%}

<div class="sk-rig" id="sk-rig-{{ section.id }}" style="--skr-accent: {{ section.settings.accent_color }}; --skr-pt: {{ section.settings.padding_top }}px; --skr-pb: {{ section.settings.padding_bottom }}px;">

  <div class="sk-rig__wrap">
    <div class="sk-rig__head">
      <span class="sk-rig__kick">{{ section.settings.kicker }}</span>
      <h2 class="sk-rig__h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.lede != blank -%}<p class="sk-rig__lede">{{ section.settings.lede }}</p>{%- endif -%}
    </div>

    <div class="sk-rig__strip">
      <article class="sk-rig__card">
        <div class="sk-rig__plate"><span class="sk-rig__tag">Step 1</span><img src="{{ B }}sk-jet-pylon.webp{{ V1 }}" width="1000" height="1144" loading="lazy" alt="BRP tow pylon"></div>
        <div class="sk-rig__ct"><span class="sk-rig__brand">BRP</span><h3>Tow pylon</h3><p>Twin-grip post on a telescopic base &mdash; the anchor point for the rope.</p><span class="sk-rig__where">Mounts on the rear deck</span></div>
      </article>
      <article class="sk-rig__card">
        <div class="sk-rig__plate"><span class="sk-rig__tag">Step 2</span><img src="{{ B }}sk-jet-rope.webp{{ V1 }}" width="1000" height="475" loading="lazy" alt="Armstrong tow rope and handle"></div>
        <div class="sk-rig__ct"><span class="sk-rig__brand">Armstrong</span><h3>Rope &amp; handle</h3><p>Triangular mesh handle and a coiled yellow-white tow line.</p><span class="sk-rig__where">Ties to the pylon head</span></div>
      </article>
      <article class="sk-rig__card">
        <div class="sk-rig__plate"><span class="sk-rig__tag">Step 3</span><img src="{{ B }}sk-jet-board.webp{{ V2 }}" width="815" height="1087" loading="lazy" alt="JETTECH inflatable tow sled"></div>
        <div class="sk-rig__ct"><span class="sk-rig__brand">JETTECH</span><h3>Inflatable sled</h3><p>Side grab handles, a blue bungee net and D-rings along the deck.</p><span class="sk-rig__where">Rides on the stern</span></div>
      </article>
      <article class="sk-rig__card">
        <div class="sk-rig__plate"><span class="sk-rig__tag">Step 4</span><img src="{{ B }}sk-jet-arch.webp{{ V2 }}" width="932" height="967" loading="lazy" alt="JAIN inflatable floats"></div>
        <div class="sk-rig__ct"><span class="sk-rig__brand">JAIN</span><h3>Inflatable floats</h3><p>Inflatable tube with handles and D-rings that hugs the hull sides.</p><span class="sk-rig__where">Runs along the hull</span></div>
      </article>
    </div>
  </div>

  <section class="sk-rig__asm" data-asm aria-label="Tow-in rig assembling on scroll">
    <div class="sk-rig__vp" data-vp>
      <div class="sk-rig__world" data-world>
        <div class="sk-rig__craft" data-craft>
          <div class="sk-rig__p" data-part="pylon"><img src="{{ B }}sk-jet-pylon.webp{{ V1 }}" alt="" loading="lazy"></div>
          <img class="sk-rig__hull" data-hull src="{{ B }}sk-jet-wake.webp{{ V1 }}" width="1774" height="887" alt="{{ section.settings.heading | escape }}" loading="lazy">
          <img class="sk-rig__hull sk-rig__clip" data-clip src="{{ B }}sk-jet-wake.webp{{ V1 }}" width="1774" height="887" alt="" loading="lazy">
          <div class="sk-rig__ov sk-rig__glow" data-glow></div>
          <div class="sk-rig__ov sk-rig__shaft" data-shaft></div>
          <div class="sk-rig__p" data-part="arch"><img src="{{ B }}sk-jet-floats.webp{{ V1 }}" alt="" loading="lazy"></div>
          <div class="sk-rig__p" data-part="board"><img src="{{ B }}sk-jet-sled.webp{{ V1 }}" alt="" loading="lazy"></div>
          <svg class="sk-rig__rope" viewBox="0 0 3900 3400" aria-hidden="true">
            <path data-rope1 d="" fill="none" stroke="#f2c21b" stroke-width="9" stroke-linecap="round"/>
            <path data-rope2 d="" fill="none" stroke="#fff" stroke-width="3" stroke-dasharray="6 14" stroke-linecap="round"/>
          </svg>
          <div class="sk-rig__p" data-part="rope"><img src="{{ B }}sk-jet-rope.webp{{ V1 }}" alt="" loading="lazy"></div>
          <canvas class="sk-rig__fx" data-fx></canvas>
          <div class="sk-rig__lbl" data-lbl="pylon"><b>Tow pylon</b>BRP</div>
          <div class="sk-rig__lbl" data-lbl="rope"><b>Rope</b>ARMSTRONG</div>
          <div class="sk-rig__lbl" data-lbl="board"><b>Sled</b>JETTECH</div>
          <div class="sk-rig__lbl" data-lbl="arch"><b>Floats</b>JAIN</div>
        </div>
      </div>

      <div class="sk-rig__top">
        <div class="sk-rig__seg" role="group" aria-label="Model">
          <button type="button" data-model="wake" aria-pressed="true">Wake Pro</button>
          <button type="button" data-model="gtx" aria-pressed="false">GTX Limited</button>
        </div>
        <div class="sk-rig__controls">
          <button type="button" class="sk-rig__btn" data-replay>&#9654; {{ section.settings.btn_replay }}</button>
          <span class="sk-rig__stepnum" data-stepnum>Exploded view</span>
        </div>
      </div>

      <div class="sk-rig__hud">
        <ol class="sk-rig__steps" data-steps>
          <li>Pylon</li><li>Rope</li><li>Sled</li><li>Floats</li><li>Ignition</li>
        </ol>
        <div class="sk-rig__cap" data-cap aria-live="off"></div>
        <div class="sk-rig__controls sk-rig__run">
          <span class="sk-rig__rpm">RPM <b data-rpm>0</b></span>
          <button type="button" class="sk-rig__btn sk-rig__btn--gas" data-gas aria-label="Throttle, hold down">{{ section.settings.btn_gas }} &#9650;</button>
          <button type="button" class="sk-rig__btn" data-sound aria-pressed="false">{{ section.settings.btn_sound_on }}</button>
        </div>
      </div>
    </div>
  </section>

  <div class="sk-rig__wrap sk-rig__outro">
    <p>{{ section.settings.outro }}</p>
  </div>

  <script type="application/json" data-caps>{{ section.settings.cap_0 | append: '|' | append: section.settings.cap_1 | append: '|' | append: section.settings.cap_2 | append: '|' | append: section.settings.cap_3 | append: '|' | append: section.settings.cap_4 | append: '|' | append: section.settings.cap_5 | split: '|' | json }}</script>
  <script type="application/json" data-sound-labels>{{ section.settings.btn_sound_on | append: '|' | append: section.settings.btn_sound_off | split: '|' | json }}</script>
  <script type="application/json" data-models>{ "wake": "{{ B }}sk-jet-wake.webp{{ V1 }}", "gtx": "{{ B }}sk-jet-gtx.webp{{ V1 }}" }</script>
</div>

<style>
  .sk-rig{
    --skr-ink:#191a1a; --skr-muted:#7c7b77; --skr-paper:#ffffff; --skr-paper-2:#f6f5f3;
    --skr-grid:rgba(244,110,149,.055); --skr-rule:rgba(25,26,26,.12);
    --skr-fd:"Barlow Condensed",-apple-system,"Segoe UI",Arial,sans-serif;
    --skr-fb:"Figtree",-apple-system,"Segoe UI",Arial,sans-serif;
    color:var(--skr-ink); font-family:var(--skr-fb); background:var(--skr-paper);
    padding-top:var(--skr-pt,36px); overflow:clip;
  }
  .sk-rig *{box-sizing:border-box}
  .sk-rig__wrap{max-width:1040px;margin:0 auto;padding:0 20px}
  .sk-rig__kick{font-size:11.5px;letter-spacing:.24em;text-transform:uppercase;color:var(--skr-accent);font-weight:700}
  .sk-rig__h2{font-family:var(--skr-fd);font-weight:700;font-size:clamp(26px,3vw,38px);line-height:1.05;letter-spacing:-.01em;margin:.35rem 0 .4rem;text-wrap:balance}
  .sk-rig__lede{font-size:15.5px;line-height:1.6;color:var(--skr-muted);max-width:60ch;margin:0}

  /* gear strip: compact 2x2, each piece on its own plate */
  .sk-rig__strip{display:grid;grid-template-columns:repeat(2,1fr);gap:clamp(12px,1.6vw,18px);margin-top:clamp(18px,2.4vw,26px)}
  .sk-rig__card{display:grid;grid-template-columns:minmax(0,118px) minmax(0,1fr);gap:14px;align-items:center;border:1px solid var(--skr-rule);border-radius:14px;padding:12px;background:var(--skr-paper)}
  .sk-rig__plate{position:relative;aspect-ratio:1/1;display:grid;place-items:center;background:var(--skr-paper-2);border-radius:10px;overflow:hidden;padding:10px}
  .sk-rig__plate img{max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain;filter:drop-shadow(0 8px 10px rgba(20,30,34,.12))}
  .sk-rig__tag{position:absolute;top:7px;left:9px;font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--skr-muted);font-weight:600}
  .sk-rig__ct{min-width:0}
  .sk-rig__brand{font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--skr-accent);font-weight:700}
  .sk-rig__ct h3{font-family:var(--skr-fd);font-weight:700;font-size:clamp(17px,1.9vw,21px);line-height:1.1;margin:2px 0 5px}
  .sk-rig__ct p{font-size:12.5px;line-height:1.5;color:#55554f;margin:0 0 6px}
  .sk-rig__where{font-size:11px;letter-spacing:.02em;color:var(--skr-muted);border-top:1px dashed var(--skr-rule);padding-top:6px;display:block}

  /* assembly: a tall section with a pinned stage; the rig assembles on scroll */
  .sk-rig__asm{position:relative;height:380svh;margin-top:clamp(20px,3vw,34px)}
  .sk-rig--static .sk-rig__asm{height:auto}
  .sk-rig--static .sk-rig__vp{position:relative}
  .sk-rig__vp{position:sticky;top:6svh;height:min(84svh,720px);overflow:hidden;border-radius:14px;
    background:var(--skr-paper);box-shadow:0 0 0 1px var(--skr-rule);direction:ltr;isolation:isolate;
    background-image:linear-gradient(var(--skr-grid) 1px,transparent 1px),linear-gradient(90deg,var(--skr-grid) 1px,transparent 1px);background-size:30px 30px}
  .sk-rig__world{position:absolute;left:0;top:0;width:3900px;height:3400px;transform-origin:0 0}
  .sk-rig__craft{position:absolute;inset:0}
  .sk-rig__world img{position:absolute;display:block;max-width:none;user-select:none;-webkit-user-drag:none;pointer-events:none}
  .sk-rig__hull{left:1500px;top:1200px;width:1774px;height:887px}
  .sk-rig__p{position:absolute;left:0;top:0;transform-origin:50% 50%}
  .sk-rig__p img{position:static!important;width:100%;height:auto}
  .sk-rig__ov{position:absolute;pointer-events:none;opacity:0;transition:opacity .4s}
  .sk-rig__glow{background:radial-gradient(closest-side,rgba(255,140,40,.75),rgba(255,120,30,.25) 60%,transparent);mix-blend-mode:screen}
  .sk-rig__shaft{background:repeating-linear-gradient(90deg,transparent 0 12px,rgba(255,255,255,.75) 12px 16px);mix-blend-mode:screen;background-size:28px 100%}
  .sk-rig__rope,.sk-rig__fx{position:absolute;left:0;top:0;width:3900px;height:3400px;pointer-events:none;overflow:visible}
  .sk-rig__lbl{position:absolute;font-size:26px;letter-spacing:.06em;color:var(--skr-ink);white-space:nowrap;opacity:.72}
  .sk-rig__lbl b{display:block;font-family:var(--skr-fd);font-weight:700;font-size:44px;letter-spacing:0}
  .sk-rig__lbl::before{content:"";position:absolute;top:-15px;left:0;width:58px;height:3px;background:var(--skr-accent)}

  .sk-rig__top{position:absolute;top:12px;left:12px;right:12px;display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap}
  .sk-rig__seg{display:inline-flex;border:1px solid var(--skr-ink);border-radius:999px;overflow:hidden;background:#fff}
  .sk-rig__seg button{font:inherit;font-size:12.5px;padding:6px 12px;border:0;background:transparent;color:var(--skr-ink);cursor:pointer}
  .sk-rig__seg button[aria-pressed="true"]{background:var(--skr-ink);color:#fff}
  .sk-rig__controls{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
  .sk-rig__stepnum{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--skr-muted)}
  .sk-rig__btn{font:inherit;font-size:12.5px;padding:7px 14px;border:1px solid var(--skr-ink);border-radius:999px;background:#fff;color:var(--skr-ink);cursor:pointer;touch-action:none;user-select:none;-webkit-user-select:none}
  .sk-rig__btn--gas{background:var(--skr-accent);border-color:var(--skr-accent);color:#fff;min-width:96px}
  .sk-rig__btn--gas.is-held{filter:brightness(.88)}
  .sk-rig__btn:focus-visible,.sk-rig__seg button:focus-visible{outline:2px solid var(--skr-accent);outline-offset:2px}
  .sk-rig__hud{position:absolute;left:0;right:0;bottom:0;padding:10px 12px 12px;display:grid;gap:8px;background:linear-gradient(to top,var(--skr-paper) 58%,rgba(255,255,255,0))}
  .sk-rig__steps{display:flex;gap:6px;flex-wrap:wrap;list-style:none;margin:0;padding:0}
  .sk-rig__steps li{font-size:11px;letter-spacing:.06em;text-transform:uppercase;padding:3px 9px;border-radius:999px;border:1px solid var(--skr-rule);color:var(--skr-muted);background:#fff;transition:all .25s}
  .sk-rig__steps li.is-on{background:var(--skr-accent);border-color:var(--skr-accent);color:#fff}
  .sk-rig__steps li.is-done{color:var(--skr-accent);border-color:var(--skr-accent)}
  .sk-rig__cap{font-family:var(--skr-fd);font-weight:700;font-size:clamp(18px,2.4vw,26px);line-height:1.12;color:var(--skr-ink);min-height:1.12em}
  .sk-rig__run{display:none}
  .sk-rig__vp.is-running .sk-rig__run{display:flex}
  .sk-rig__rpm{font-variant-numeric:tabular-nums;font-size:12px;padding:6px 12px;border-radius:999px;border:1px solid var(--skr-rule);min-width:104px;text-align:center}
  .sk-rig__rpm b{font-size:15px}

  .sk-rig__outro{margin-top:clamp(18px,2.4vw,28px);padding-bottom:var(--skr-pb,36px)}
  .sk-rig__outro p{font-size:12.5px;line-height:1.6;color:var(--skr-muted);max-width:66ch;margin:0}

  @media (max-width:760px){
    .sk-rig__strip{grid-template-columns:1fr}
    .sk-rig__vp{height:min(78svh,640px)}
    .sk-rig__lbl{font-size:32px}.sk-rig__lbl b{font-size:56px}
  }
  @media (prefers-reduced-motion:reduce){
    .sk-rig__plate img{transition:none}
  }
</style>

<script>
(function(){
  var root=document.getElementById('sk-rig-{{ section.id }}');
  if(!root||root.dataset.ready) return; root.dataset.ready='1';
  var $=function(s){return root.querySelector(s)}, $$=function(s){return Array.prototype.slice.call(root.querySelectorAll(s))};
  var vp=$('[data-vp]'), world=$('[data-world]'), craft=$('[data-craft]'), sec=$('[data-asm]');
  var reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
  var CAPS=JSON.parse($('[data-caps]').textContent), SOUNDL=JSON.parse($('[data-sound-labels]').textContent), IMG=JSON.parse($('[data-models]').textContent);

  var OX=1500, OY=1200;
  function wx(x){return x+OX} function wy(y){return y+OY}
  function clamp(v,a,b){return Math.max(a,Math.min(b,v))} function lerp(a,b,t){return a+(b-a)*t}
  function io(t){return t<.5?4*t*t*t:1-Math.pow(-2*t+2,3)/2}
  function seg(t,a,b){return clamp((t-a)/(b-a),0,1)}

  var MODELS={
    wake:{src:'wake',nozzle:[52,655],engine:[530,545,905,765],shaft:[300,645,525,672]},
    gtx:{src:'gtx',nozzle:[68,655],engine:[520,545,905,765],shaft:[300,640,515,670]}
  };
  var model=MODELS.wake;

  var PARTS={
    pylon:{ar:1144/1000, s:[-560,250,440,0],  f:[338,382,190,0],   t:[.7,1.8], lift:140},
    rope: {ar:475/1000,  s:[-560,900,640,-4], f:[-1170,760,420,0], t:[1.9,3.0], lift:60},
    board:{ar:1087/539,  s:[2060,290,300,6],  f:[-310,690,500,-90],t:[3.7,5.1], lift:300, tilt:66, slope:-7},
    arch: {ar:955/129,   s:[2000,960,96,-90], f:[900,505,170,-91.8],t:[5.3,6.5], lift:80, stretch:1.36}
  };
  var LBL_L={pylon:[-560,560],rope:[-560,1120],board:[2060,640],arch:[2000,1080]};
  var LBL_T={pylon:[.5,.8],rope:[1.8,2.1],board:[3.5,3.8],arch:[5.2,5.5]};
  var START_P={pylon:[300,-620,520,0],board:[1380,-640,330,6],rope:[560,1300,860,-4],arch:[1350,1250,110,-90]};
  var LBL_P={pylon:[300,-260],board:[1380,-280],rope:[560,1550],arch:[1350,1390]};
  var START_L={}; for(var k0 in PARTS) START_L[k0]=PARTS[k0].s.slice();

  var el={}, lb={};
  for(var k in PARTS){ el[k]=$('[data-part="'+k+'"]'); el[k].style.width=PARTS[k].s[2]+'px'; lb[k]=$('[data-lbl="'+k+'"]'); }

  var portrait=null;
  function layout(){
    var p=vp.clientWidth/vp.clientHeight<0.9;
    if(p===portrait) return; portrait=p;
    var LB=p?LBL_P:LBL_L;
    for(var k in PARTS){
      PARTS[k].s=(p?START_P:START_L)[k].slice();
      el[k].style.width=PARTS[k].s[2]+'px';
      lb[k].style.left=(wx(LB[k][0])-PARTS[k].s[2]/2)+'px';
      lb[k].style.top=wy(LB[k][1])+'px';
    }
  }
  function placePart(k,t){
    var P=PARTS[k], e=io(seg(t,P.t[0],P.t[1])), w=P.s[2], h=w*P.ar;
    var cx=lerp(P.s[0],P.f[0],e), cy=lerp(P.s[1],P.f[1],e)-Math.sin(Math.PI*e)*P.lift;
    var sc=lerp(1,P.f[2]/w,e), rot=lerp(P.s[3],P.f[3],e);
    var tilt=(P.tilt||0)*e, slope=(P.slope||0)*e, st=lerp(1,P.stretch||1,e);
    el[k].style.transform='translate('+(wx(cx)-w/2)+'px,'+(wy(cy)-h/2)+'px)'+(tilt?' rotate('+slope+'deg) perspective(1800px) rotateX('+tilt+'deg)':'')+' rotate('+rot+'deg) scale('+sc+','+(sc*st)+')';
    lb[k].style.opacity=1-seg(t,LBL_T[k][0],LBL_T[k][1]);
  }

  var glow=$('[data-glow]'), shaft=$('[data-shaft]'), clip=$('[data-clip]'), hull=$('[data-hull]');
  function placeOverlays(){
    var E=model.engine, S=model.shaft;
    glow.style.cssText+=';left:'+wx(E[0]-40)+'px;top:'+wy(E[1]-30)+'px;width:'+(E[2]-E[0]+80)+'px;height:'+(E[3]-E[1]+60)+'px';
    shaft.style.cssText+=';left:'+wx(S[0])+'px;top:'+wy(S[1])+'px;width:'+(S[2]-S[0])+'px;height:'+(S[3]-S[1])+'px';
    clip.style.clipPath='inset('+E[1]+'px '+(1774-E[2])+'px '+(887-E[3])+'px '+E[0]+'px)';
  }

  var CAMS_P={E:{x:-80,y:-1060,w:1940,h:2950},R1:{x:-520,y:-140,w:1180,h:1180},R2:{x:-1450,y:100,w:1750,h:1000},F:{x:-1450,y:-700,w:3400,h:2200},R4:{x:-60,y:60,w:1950,h:1000},F2:{x:-1450,y:200,w:3400,h:700},EN:{x:-1450,y:80,w:2250,h:1000}};
  var CAMS_L={E:{x:-1000,y:-480,w:3400,h:1640},R1:{x:-760,y:40,w:1500,h:820},R2:{x:-1500,y:200,w:1950,h:800},F:{x:-1450,y:0,w:3750,h:1000},R4:{x:-60,y:200,w:2000,h:700},F2:{x:-1450,y:140,w:3400,h:780},EN:{x:-1450,y:280,w:2550,h:720}};
  var CAMK=[[0,'E'],[.5,'E'],[1.3,'R1'],[1.9,'R1'],[2.5,'R2'],[3.5,'R2'],[4.3,'F'],[5.2,'F'],[6.2,'R4'],[6.7,'R4'],[7.6,'F2'],[7.8,'F2'],[8.7,'EN'],[9.4,'EN']];
  var TEND=9.4;
  function camAt(t){
    var C=portrait?CAMS_P:CAMS_L;
    for(var i=0;i<CAMK.length-1;i++){
      var a=CAMK[i], b=CAMK[i+1];
      if(t<=b[0]){ var e=io(seg(t,a[0],b[0])), A=C[a[1]], B=C[b[1]];
        return {x:lerp(A.x,B.x,e),y:lerp(A.y,B.y,e),w:lerp(A.w,B.w,e),h:lerp(A.h,B.h,e)}; }
    }
    return C.EN;
  }
  function applyCam(c){
    var W=vp.clientWidth, H=vp.clientHeight, topPad=52, botPad=Math.min(170,H*.26);
    var ah=Math.max(120,H-topPad-botPad), s=Math.min(W/c.w, ah/c.h);
    var tx=(W-c.w*s)/2-wx(c.x)*s, ty=topPad+(ah-c.h*s)/2-wy(c.y)*s;
    world.style.transform='translate('+tx+'px,'+ty+'px) scale('+s+')';
  }

  var rp=$('[data-rope1]'), rp2=$('[data-rope2]');
  var d='M'+wx(338)+','+wy(282)+' Q'+wx(-330)+','+wy(540)+' '+wx(-1010)+','+wy(690);
  rp.setAttribute('d',d); rp2.setAttribute('d',d);
  var RL=rp.getTotalLength(); rp.style.strokeDasharray=RL;

  var chips=$$('[data-steps] li'), cap=$('[data-cap]'), stepnum=$('[data-stepnum]'), STEPT=[.15,1.9,3.6,5.2,8.6], cur=-1;
  function setStep(i){
    if(i===cur) return; cur=i;
    chips.forEach(function(li,j){ li.classList.toggle('is-on',j===i-1); li.classList.toggle('is-done',j<i-1); });
    cap.textContent=CAPS[i]||'';
    stepnum.textContent=i===0?'Exploded view':('Step '+i+' of 5');
  }

  var tCur=0, tTarget=0, sraf=0;
  function render(t){
    applyCam(camAt(t));
    for(var k in PARTS) placePart(k,t);
    rp.style.strokeDashoffset=RL*(1-io(seg(t,2.8,3.5)));
    rp2.style.opacity=seg(t,3.3,3.5);
    var s=0; STEPT.forEach(function(v,i){ if(t>=v) s=i+1; }); setStep(s);
    if(t>=8.65) startEngine(); else stopEngine();
  }

  // play (clock) mode — used by Replay and the static fallback
  var mode='scroll', playing=false, playStart=0, PLAY_MS=reduce?6000:12500;
  function play(){
    playing=true; playStart=performance.now();
    if(mode==='scroll'){ scrollTo({top:sec.getBoundingClientRect().top+window.pageYOffset,behavior:'instant'}); }
    requestAnimationFrame(playTick);
  }
  function playTick(now){
    if(!playing) return;
    var k=clamp((now-playStart)/PLAY_MS,0,1); tCur=tTarget=k*TEND; render(tCur);
    if(k<1){ requestAnimationFrame(playTick); return; }
    playing=false;
    if(mode==='scroll'){ var r=sec.getBoundingClientRect(); scrollTo({top:r.top+window.pageYOffset+r.height-innerHeight,behavior:'instant'}); }
  }
  ['wheel','touchstart','keydown'].forEach(function(ev){ addEventListener(ev,function(e){
    if(!playing||mode!=='scroll') return;
    if(e.target.closest&&e.target.closest('button')) return;
    playing=false; readScroll();
  },{passive:true}); });

  function readScroll(){
    if(playing||mode!=='scroll') return;
    var r=sec.getBoundingClientRect(), span=r.height-innerHeight;
    if(span<=0){ return; }
    tTarget=clamp(-r.top/span,0,1)*TEND;
    if(!sraf) sraf=requestAnimationFrame(step);
  }
  function step(){
    tCur+= reduce ? (tTarget-tCur) : (tTarget-tCur)*.14;
    if(Math.abs(tTarget-tCur)<.0015) tCur=tTarget;
    render(tCur);
    sraf = tCur!==tTarget ? requestAnimationFrame(step) : 0;
  }
  addEventListener('scroll',readScroll,{passive:true});
  addEventListener('resize',function(){ if(mode==='static') sizeStatic(); var was=portrait; layout(); if(was!==portrait) placeOverlays(); render(tCur); });

  function sizeStatic(){
    var W=document.documentElement.clientWidth;
    var h=Math.round(clamp(W<700?W*1.5:W*0.56,440,760));
    vp.style.height=h+'px';
  }
  function checkMode(){
    var se=document.scrollingElement||document.documentElement;
    var canScroll=se.scrollHeight-innerHeight>innerHeight*1.5 && innerHeight<1800;
    if(canScroll||mode==='static') return;
    mode='static'; root.classList.add('sk-rig--static');
    sizeStatic(); portrait=null; layout(); render(0);
    setTimeout(play,500);
  }
  $('[data-replay]').addEventListener('click',function(){ play(); });

  // model switch
  var modelBtns=$$('[data-model]');
  function setModel(name){
    model=MODELS[name]||MODELS.wake; hull.src=IMG[model.src]; clip.src=IMG[model.src]; placeOverlays();
    modelBtns.forEach(function(b){ b.setAttribute('aria-pressed', b.dataset.model===name); });
  }
  modelBtns.forEach(function(b){ b.addEventListener('click',function(){ setModel(b.dataset.model); }); });

  // engine + water
  var cv=$('[data-fx]'), cx=cv.getContext('2d');
  var RES=(matchMedia('(max-width:760px)').matches||/iPhone|iPad|Android/.test(navigator.userAgent))?0.3:0.5; cv.width=3900*RES; cv.height=3400*RES;
  var running=false, visible=true, throttle=0, target=0, drops=[], raf=0, t0=performance.now(), rpmShown=0, WATER=742;
  var rpmEl=$('[data-rpm]');
  function kick(){ if(!raf&&visible){ t0=performance.now(); raf=requestAnimationFrame(loop); } }
  function startEngine(){ if(running) return; running=true; vp.classList.add('is-running'); shaft.style.opacity=1; kick(); if(audio) audio.on(); }
  function stopEngine(){ if(!running) return; running=false; vp.classList.remove('is-running'); glow.style.opacity=0; shaft.style.opacity=0; target=0; if(audio) audio.off(); }
  function loop(now){
    raf=0; if(!visible) return;
    var dt=Math.min(.05,(now-t0)/1000); t0=now;
    throttle+=(target-throttle)*Math.min(1,dt*(target>throttle?3:1.6));
    var T=now/1000;
    if(running&&!reduce){
      var a=.6+throttle*1.4, j=1.2+throttle*2.5;
      craft.style.transform='translate('+(Math.random()-.5)*a+'px,'+(Math.random()-.5)*a+'px)';
      clip.style.transform='translate('+(Math.random()-.5)*j+'px,'+(Math.random()-.5)*j+'px)';
    } else { craft.style.transform=''; clip.style.transform=''; }
    if(running){
      glow.style.opacity=(.55+throttle*.4+Math.random()*.12).toFixed(2);
      shaft.style.backgroundPositionX=((T*(300+throttle*1400))%28)+'px';
      var rpm=1550+throttle*6100+(Math.random()-.5)*60; rpmShown+=(rpm-rpmShown)*.25; rpmEl.textContent=Math.round(rpmShown/10)*10;
      var n=reduce?3:Math.round(10+throttle*26), nz=model.nozzle;
      for(var i=0;i<n;i++){
        var sp=760+throttle*1500+Math.random()*300, ang=Math.PI+(Math.random()-.5)*(.12+throttle*.08)-.03;
        drops.push({x:nz[0]+Math.random()*6,y:nz[1]+(Math.random()-.5)*14,vx:Math.cos(ang)*sp,vy:Math.sin(ang)*sp+(Math.random()-.4)*40,life:0,max:.7+Math.random()*.6,r:3+Math.random()*7,k:Math.random()});
      }
    }
    cx.setTransform(RES,0,0,RES,0,0); cx.clearRect(0,0,3900,3400);
    if(running||drops.length){
      var wa=running?1:.6;
      cx.beginPath(); cx.moveTo(wx(-1500),wy(WATER));
      for(var x=-1500;x<=2400;x+=24){
        var y=WATER+Math.sin(x*.012+T*2.2)*5+Math.sin(x*.031-T*3.1)*2.5+(x<60&&x>-900?Math.sin(x*.05+T*9)*(2+throttle*6)*(1-(60-x)/960):0);
        cx.lineTo(wx(x),wy(y));
      }
      cx.strokeStyle='rgba(20,110,140,'+(.7*wa)+')'; cx.lineWidth=3; cx.stroke();
      cx.lineTo(wx(2400),wy(1160)); cx.lineTo(wx(-1500),wy(1160)); cx.closePath();
      var g=cx.createLinearGradient(0,wy(WATER),0,wy(900));
      g.addColorStop(0,'rgba(23,143,170,'+(.22*wa)+')'); g.addColorStop(1,'rgba(23,143,170,0)');
      cx.fillStyle=g; cx.fill();
      if(running){
        var nz2=model.nozzle, len=420+throttle*700, nx=nz2[0], ny=nz2[1];
        var sg=cx.createLinearGradient(wx(nx),0,wx(nx-len),0);
        sg.addColorStop(0,'rgba(190,235,250,.95)'); sg.addColorStop(.6,'rgba(90,180,215,.55)'); sg.addColorStop(1,'rgba(90,180,215,0)');
        cx.fillStyle=sg; cx.beginPath();
        cx.moveTo(wx(nx),wy(ny-11));
        cx.quadraticCurveTo(wx(nx-len*.6),wy(ny-16-throttle*10),wx(nx-len),wy(ny+40+throttle*30));
        cx.quadraticCurveTo(wx(nx-len*.55),wy(ny+22+throttle*14),wx(nx),wy(ny+11));
        cx.fill(); cx.strokeStyle='rgba(30,120,160,.45)'; cx.lineWidth=2; cx.stroke();
      }
    }
    for(var i2=drops.length-1;i2>=0;i2--){
      var p=drops[i2]; p.life+=dt; p.vy+=900*dt; p.vx*=(1-dt*.8); p.x+=p.vx*dt; p.y+=p.vy*dt;
      if(p.y>WATER+4){ p.y=WATER+4; p.vy*=-.18; p.vx*=.5; p.max=Math.min(p.max,p.life+.25); }
      var al=1-p.life/p.max; if(al<=0){ drops.splice(i2,1); continue; }
      cx.beginPath(); cx.arc(wx(p.x),wy(p.y),p.r*(1+p.life*1.6),0,6.283);
      cx.fillStyle=p.k>.55?'rgba(255,255,255,'+(.85*al)+')':'rgba(110,195,225,'+(.6*al)+')'; cx.fill();
      if(p.k>.55){ cx.strokeStyle='rgba(40,130,170,'+(.5*al)+')'; cx.lineWidth=1.5; cx.stroke(); }
    }
    if(running||drops.length) raf=requestAnimationFrame(loop);
    else { craft.style.transform=''; cx.clearRect(0,0,3900,3400); }
  }

  // throttle
  var gas=$('[data-gas]');
  function down(e){ e.preventDefault(); target=1; gas.classList.add('is-held'); kick(); }
  function up(){ target=0; gas.classList.remove('is-held'); }
  gas.addEventListener('pointerdown',down);
  ['pointerup','pointerleave','pointercancel'].forEach(function(ev){ gas.addEventListener(ev,up); });
  gas.addEventListener('keydown',function(e){ if(e.key===' '||e.key==='Enter') down(e); });
  gas.addEventListener('keyup',up);
  gas.addEventListener('contextmenu',function(e){ e.preventDefault(); });

  // synthesized engine sound (after a tap)
  var audio=null, soundOn=false, sb=$('[data-sound]');
  function makeAudio(){
    var AC=window.AudioContext||window.webkitAudioContext; if(!AC) return null;
    var ac=new AC(), master=ac.createGain(); master.gain.value=0; master.connect(ac.destination);
    var lp=ac.createBiquadFilter(); lp.type='lowpass'; lp.frequency.value=500; lp.Q.value=4;
    var am=ac.createGain(); am.gain.value=.6; am.connect(lp); lp.connect(master);
    var o1=ac.createOscillator(); o1.type='sawtooth'; var o2=ac.createOscillator(); o2.type='square';
    var g2=ac.createGain(); g2.gain.value=.35; o1.connect(am); o2.connect(g2); g2.connect(am);
    var lfo=ac.createOscillator(), lg=ac.createGain(); lg.gain.value=.35; lfo.connect(lg); lg.connect(am.gain);
    var nb=ac.createBuffer(1,ac.sampleRate*2,ac.sampleRate), ch=nb.getChannelData(0);
    for(var i=0;i<ch.length;i++) ch[i]=Math.random()*2-1;
    var ns=ac.createBufferSource(); ns.buffer=nb; ns.loop=true;
    var bp=ac.createBiquadFilter(); bp.type='bandpass'; bp.frequency.value=1400; bp.Q.value=.8;
    var ng=ac.createGain(); ng.gain.value=0; ns.connect(bp); bp.connect(ng); ng.connect(master);
    [o1,o2,lfo,ns].forEach(function(n){ n.start(); });
    var live=false;
    setInterval(function(){
      var f=36+throttle*115, t=ac.currentTime;
      o1.frequency.setTargetAtTime(f,t,.05); o2.frequency.setTargetAtTime(f*.5,t,.05); lfo.frequency.setTargetAtTime(f*1.5,t,.05);
      lp.frequency.setTargetAtTime(380+throttle*2200,t,.08); ng.gain.setTargetAtTime(live?(.12+throttle*.35):0,t,.1);
    },50);
    return { on:function(){ live=true; ac.resume(); master.gain.setTargetAtTime(.28,ac.currentTime,.25); },
             off:function(){ live=false; master.gain.setTargetAtTime(0,ac.currentTime,.15); } };
  }
  sb.addEventListener('click',function(){
    soundOn=!soundOn;
    if(soundOn){ if(!audio) audio=makeAudio(); if(audio&&running) audio.on(); } else if(audio) audio.off();
    sb.setAttribute('aria-pressed',soundOn); sb.textContent=soundOn?SOUNDL[1]:SOUNDL[0];
  });

  // init
  setModel('{{ section.settings.default_model }}');
  layout(); readScroll(); render(tCur);
  setTimeout(checkMode,700);
  // pause the water loop + sound when the stage is off-screen
  if('IntersectionObserver' in window){
    new IntersectionObserver(function(es){ es.forEach(function(e){
      visible=e.isIntersecting;
      if(visible){ if(running) kick(); if(audio&&soundOn&&running) audio.on(); }
      else if(audio){ audio.off(); }
    }); },{threshold:0}).observe(vp);
  }
})();
</script>

