{%- comment -%}
  SHOKOGI foil — the jet ski on its own: a Sea-Doo tow ski (Wake Pro / GTX
  Limited) you can rev with the throttle, with engine sound and a model
  toggle. The scroll-assembly of the tow rig (pylon, rope, sled, floats) was
  removed on the owner's request — this is just the ski. The ski image +
  engine/water FX + sound are the proven prototype code, inside a Shadow DOM so
  its CSS can't touch the theme. A SHOKOGI-styled heading frames it in brand.
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Secular+One&family=IBM+Plex+Mono:wght@400;500&display=swap">
{{ 'sk.css' | asset_url | stylesheet_tag }}

<div class="skp"><div class="sec"><div class="wrap" style="text-align:center">
  <div class="kicker">04 &middot; Our Equipment</div>
  <h2>The Gear We Run &mdash; World-Class</h2>
  <p class="lead">The craft and gear we run for tow-in foiling in Playa Venao, at the highest level. Switch between our two Sea-Doo jet skis and our boat, The&nbsp;Bee &mdash; hold the throttle to rev the engine, with engine sound on.</p>
</div></div></div>

<div id="skrig-host-{{ section.id }}"></div>
<template id="skrig-tpl-{{ section.id }}">
<style>
:host{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}:host{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}
:host{
  --paper:#f5f7f6;
  --paper-2:#eaefed;
  --ink:#15191b;
  --muted:#5a6569;
  --teal:#178f87;
  --orange:#e2681b;
  --grid:rgba(23,143,135,.09);
  --rule:rgba(21,25,27,.14);
  --f-display:"Secular One",system-ui,sans-serif;
  --f-body:system-ui,-apple-system,"Segoe UI",Arial,sans-serif;
  --f-mono:"IBM Plex Mono",ui-monospace,Menlo,Consolas,monospace;
  color-scheme:light;
}
*{box-sizing:border-box}
:host{background:var(--paper);color:var(--ink);font-family:var(--f-body);font-size:16px;line-height:1.6;}
.page{background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);background-size:28px 28px;}
h2{font-family:var(--f-display);font-weight:400;line-height:1.05;margin:0}
p{margin:0}

#stage{position:relative}
.viewport{position:relative;height:300px;overflow:hidden;background:var(--paper);background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);background-size:28px 28px;direction:ltr}
.world{position:absolute;left:0;top:0;width:3900px;height:3400px;transform-origin:0 0}
@media(max-width:760px){.world{zoom:.3}}
.craft{position:absolute;inset:0}
.world img{position:absolute;display:block;user-select:none;-webkit-user-drag:none;pointer-events:none}
#hull{left:1500px;top:1200px;width:1774px;height:887px}
#engineClip{left:1500px;top:1200px;width:1774px;height:887px}
.ov{position:absolute;pointer-events:none;opacity:0;transition:opacity .4s}
#glow{background:radial-gradient(closest-side,rgba(255,140,40,.75),rgba(255,120,30,.25) 60%,transparent);mix-blend-mode:screen}
#shaft{background:repeating-linear-gradient(90deg,transparent 0 12px,rgba(255,255,255,.75) 12px 16px);mix-blend-mode:screen;background-size:28px 100%}
#fx{position:absolute;left:0;top:0;width:3900px;height:3400px;pointer-events:none}

.hud{position:absolute;inset:auto 0 0 0;padding:12px max(16px,env(safe-area-inset-right,0px)) calc(14px + env(safe-area-inset-bottom,0px)) max(16px,env(safe-area-inset-left,0px));direction:ltr;display:grid;gap:10px;background:linear-gradient(to top,var(--paper) 55%,rgba(245,247,246,0))}
.topbar{position:absolute;top:calc(12px + env(safe-area-inset-top,0px));right:max(16px,env(safe-area-inset-right,0px));left:max(16px,env(safe-area-inset-left,0px));display:flex;justify-content:center;align-items:center;gap:10px;direction:ltr;flex-wrap:wrap}
.seg{display:inline-flex;border:1.5px solid var(--ink);background:#fff;border-radius:999px;overflow:hidden;box-shadow:0 4px 14px rgba(21,25,27,.1)}
.seg button{font:600 14px var(--f-mono);letter-spacing:.03em;padding:10px 18px;border:0;background:transparent;color:var(--ink);cursor:pointer;white-space:nowrap}
.seg button+button{border-left:1.5px solid var(--ink)}
.seg button[aria-pressed="true"]{background:var(--ink);color:#fff}
@media(max-width:430px){
  .seg button{padding:9px 12px;font-size:12px}
  .controls{gap:6px;flex-wrap:nowrap}
  .rpm{min-width:0;font-size:12px;padding:8px 10px}
  .rpm b{font-size:16px}
  .btn{padding:9px 12px;font-size:13px}
  .btn.gas{min-width:78px}
}
.controls{display:flex;gap:8px;align-items:center;justify-content:center;flex-wrap:wrap}
.btn{font:500 14px var(--f-body);padding:10px 16px;border:1px solid var(--ink);background:#fff;color:var(--ink);cursor:pointer;touch-action:none;user-select:none;-webkit-user-select:none}
.btn.gas{background:var(--orange);border-color:var(--orange);color:#fff;min-width:96px}
.btn.gas.held{background:#b84f10}
.btn:focus-visible,.seg button:focus-visible{outline:3px solid var(--teal);outline-offset:2px}
.rpm{font-family:var(--f-mono);font-variant-numeric:tabular-nums;font-size:14px;padding:9px 12px;border:1px solid var(--rule);background:#fff;min-width:104px;text-align:center}
.rpm b{font-size:18px;font-weight:500}
@media (prefers-reduced-motion:reduce){ .ov{transition:none} }
</style>
<div class="page" dir="ltr" lang="en">
<div id="stage">
  <div class="viewport" id="vp">
    <div class="world" id="world">
      <div class="craft" id="craft">
        <img id="hull" data-img="wake" alt="Sea-Doo jet ski">
        <img id="engineClip" data-img="wake" alt="">
        <div class="ov" id="glow"></div>
        <div class="ov" id="shaft"></div>
        <canvas id="fx"></canvas>
      </div>
    </div>

    <div class="topbar">
      <div class="seg" role="group" aria-label="Choose model">
        <button type="button" id="m-wake" aria-pressed="true">Wake Pro</button>
        <button type="button" id="m-gtx" aria-pressed="false">GTX Limited</button>
        <button type="button" id="m-bee" aria-pressed="false">The Bee</button>
      </div>
    </div>

    <div class="hud">
      <div class="controls">
        <div class="rpm" aria-live="off">RPM <b id="rpm">0</b></div>
        <button type="button" class="btn gas" id="gas" aria-label="Throttle, hold down">Throttle ▲</button>
        <button type="button" class="btn" id="sound" aria-pressed="false">Sound on</button>
      </div>
    </div>
  </div>
</div>
</div>
</template>

<style>
.skp .rig{display:grid;grid-template-columns:repeat(auto-fit,minmax(128px,1fr));gap:11px;margin-top:22px;max-width:760px;margin-left:auto;margin-right:auto}
.skp .rigcard{background:var(--card);border:1px solid var(--line);border-radius:12px;overflow:hidden;display:flex;flex-direction:column}
.skp .rigcard .rp{height:132px;background:var(--soft);display:flex;align-items:center;justify-content:center;padding:12px;overflow:hidden;border-bottom:1px solid var(--line)}
.skp .rigcard .rp img{max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain}
.skp .rigcard .rb{padding:10px 11px 12px;display:flex;flex-direction:column;gap:4px}
.skp .rigcard .rbrand{font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:var(--pink);font-weight:700;line-height:1}
.skp .rigcard h3{font-size:12px;letter-spacing:.03em;text-transform:uppercase;margin:0;color:var(--ink);line-height:1.2}
.skp .rigcard p{font-size:11px;color:var(--muted);margin:0;line-height:1.45}
</style>
<div class="skp"><div class="sec" style="padding-top:0"><div class="wrap">
  <div class="rig">
    <article class="rigcard"><div class="rp"><img src="https://cdn.shopify.com/s/files/1/0116/5364/4354/files/sk-jet-sled.webp?v=1792879218&width=600" alt="Tow sled" loading="lazy"></div><div class="rb"><span class="rbrand">JetTech</span><h3>Tow Sled</h3><p>An inflatable sled with side grab handles, a bungee net and D-rings; rides at the stern.</p></div></article>
    <article class="rigcard"><div class="rp"><img src="https://cdn.shopify.com/s/files/1/0116/5364/4354/files/sk-jet-rope.webp?v=1792879218&width=600" alt="Tow rope and handle" loading="lazy"></div><div class="rb"><span class="rbrand">Armstrong</span><h3>Tow Rope &amp; Handle</h3><p>A mesh-grip handle on a coiled braided rope; ties to the pylon and trails behind the ski.</p></div></article>
    <article class="rigcard"><div class="rp"><img src="https://cdn.shopify.com/s/files/1/0116/5364/4354/files/sk-jet-floats.webp?v=1792879218&width=600" alt="Airjain collar" loading="lazy"></div><div class="rb"><span class="rbrand">Airjain</span><h3>Collar</h3><p>The inflatable collar that hugs the hull sides &mdash; with grab handles and D-rings for stability.</p></div></article>
    <article class="rigcard"><div class="rp"><img src="https://cdn.shopify.com/s/files/1/0116/5364/4354/files/sk-jet-pylon.webp?v=1792879218&width=600" alt="Tow pylon" loading="lazy"></div><div class="rb"><span class="rbrand">BRP</span><h3>Tow Pylon</h3><p>Two grab handles, a telescopic tube and a footed base &mdash; the rope&rsquo;s anchor point on the rear deck.</p></div></article>
  </div>
</div></div></div>

<script>
(function(){
  var host=document.getElementById('skrig-host-{{ section.id }}');
  if(!host||host.dataset.ready) return; host.dataset.ready='1';
  var tpl=document.getElementById('skrig-tpl-{{ section.id }}');
  if(!host.attachShadow){ host.appendChild(tpl.content.cloneNode(true)); return; }
  var sr=host.attachShadow({mode:'open'});
  sr.appendChild(tpl.content.cloneNode(true));

const IMG={gtx:"https://cdn.shopify.com/s/files/1/0116/5364/4354/files/sk-jet-gtx.webp?v=1792879218",wake:"https://cdn.shopify.com/s/files/1/0116/5364/4354/files/sk-jet-wake.webp?v=1792879218",bee:"https://cdn.shopify.com/s/files/1/0116/5364/4354/files/sk-boat-thebee-t.png?v=1792910072"};
const MOBILE=matchMedia('(max-width:760px)').matches||/iPhone|iPad|iPod|Android/.test(navigator.userAgent);
const IW=MOBILE?820:1280;
const WIDE=u=>(!u||u.slice(0,5)==='data:')?u:u+(u.indexOf('?')>-1?'&':'?')+'width='+IW;
for(const im of sr.querySelectorAll('img[data-img]')) im.src=WIDE(IMG[im.dataset.img]);
(function(){
const OX=1500, OY=1200;               // image coords -> world coords
const wx=x=>x+OX, wy=y=>y+OY;
const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));

const MODELS={
  wake:{src:'wake',jet:true,dir:-1,nozzle:[52,655],engine:[530,545,905,765],shaft:[300,645,525,672],camL:{x:-130,y:120,w:1926,h:770},camP:{x:-22,y:114,w:1808,h:739}},
  gtx:{src:'gtx',jet:true,dir:-1,nozzle:[68,655],engine:[520,545,905,765],shaft:[300,640,515,670],camL:{x:-130,y:120,w:1926,h:770},camP:{x:-22,y:114,w:1808,h:739}},
  bee:{src:'bee',jet:false,dir:1,nozzle:[1690,672],engine:[1560,275,1730,560],shaft:[1700,650,1730,680],camL:{x:20,y:40,w:1900,h:820},camP:{x:17,y:39,w:1765,h:838}}
};
let model=MODELS.wake;

const world=sr.getElementById('world'), vp=sr.getElementById('vp');

// per-craft camera framing (image coords): each model carries its own big, centered frame
function cam(){ return (vp.clientWidth/vp.clientHeight<0.9)?model.camP:model.camL; }
function applyCam(c){
  const W=vp.clientWidth, H=vp.clientHeight;
  const topPad=48, botPad=Math.min(80,H*.16);
  const ah=Math.max(120,H-topPad-botPad);
  const s=Math.min(W/c.w, ah/c.h);
  const tx=(W-c.w*s)/2 - wx(c.x)*s;
  const ty=topPad+(ah-c.h*s)/2 - wy(c.y)*s;
  world.style.transform=MOBILE?`translate(${tx/0.3}px,${ty/0.3}px) scale(${s/0.3})`:`translate(${tx}px,${ty}px) scale(${s})`;
}

// engine / jet overlays
function placeOverlays(){
  const [ex1,ey1,ex2,ey2]=model.engine, [sx1,sy1,sx2,sy2]=model.shaft;
  Object.assign(sr.getElementById('glow').style,{left:wx(ex1-40)+'px',top:wy(ey1-30)+'px',width:(ex2-ex1+80)+'px',height:(ey2-ey1+60)+'px'});
  Object.assign(sr.getElementById('shaft').style,{left:wx(sx1)+'px',top:wy(sy1)+'px',width:(sx2-sx1)+'px',height:(sy2-sy1)+'px'});
  sr.getElementById('engineClip').style.clipPath=`inset(${ey1}px ${1774-ex2}px ${887-ey2}px ${ex1}px)`;
}
placeOverlays();

// responsive viewport height (no scroll scrubbing anymore — it's a normal block)
function sizeViewport(){
  const W=document.documentElement.clientWidth;
  vp.style.height=Math.round(clamp(W<700?W*0.76:W*0.46,280,520))+'px';
}

// model switch
function setModel(name){
  model=MODELS[name];
  sr.getElementById('hull').src=WIDE(IMG[model.src]);
  sr.getElementById('engineClip').src=WIDE(IMG[model.src]);
  ['wake','gtx','bee'].forEach(m=>sr.getElementById('m-'+m).setAttribute('aria-pressed',name===m));
  if(!model.jet){ glow.style.opacity=0; shaft.style.opacity=0; }
  placeOverlays();
  applyCam(cam());
}
sr.getElementById('m-wake').onclick=()=>setModel('wake');
sr.getElementById('m-gtx').onclick=()=>setModel('gtx');
sr.getElementById('m-bee').onclick=()=>setModel('bee');

// engine + water
const cv=sr.getElementById('fx'), cx=cv.getContext('2d');
const RES=MOBILE?0.3:0.5; cv.width=3900*RES; cv.height=3400*RES;
let running=false, throttle=0, target=0, parts=[], raf=0, t0=performance.now(), rpmShown=0, offscreen=false;
const craft=sr.getElementById('craft'), clip=sr.getElementById('engineClip');
const glow=sr.getElementById('glow'), shaft=sr.getElementById('shaft');
  if(MOBILE){ glow.style.mixBlendMode='normal'; shaft.style.mixBlendMode='normal'; }
const rpmEl=sr.getElementById('rpm');
function startEngine(){
  if(running||offscreen) return; running=true;
  if(model.jet) shaft.style.opacity=1;
  if(!raf) raf=requestAnimationFrame(loop);
  if(soundOn){ ensureAudio(); if(audio) audio.on(); }
}
function stopEngine(){
  if(!running) return; running=false;
  glow.style.opacity=0; shaft.style.opacity=0; target=0;
  if(audio) audio.off();
}
const WATER=742;
function loop(now){
  const dt=Math.min(.05,(now-t0)/1000); t0=now;
  throttle+=(target-throttle)*Math.min(1,dt*(target>throttle?3:1.6));
  const T=now/1000;
  // shake + engine jitter
  if(running && !reduce){
    const a=.6+throttle*1.4;
    craft.style.transform=`translate(${(Math.random()-.5)*a}px,${(Math.random()-.5)*a}px)`;
    const j=1.2+throttle*2.5;
    clip.style.transform=`translate(${(Math.random()-.5)*j}px,${(Math.random()-.5)*j}px)`;
  } else { craft.style.transform=''; clip.style.transform=''; }
  if(running){
    if(model.jet){
      glow.style.opacity=(.55+throttle*.4+Math.random()*.12).toFixed(2);
      shaft.style.backgroundPositionX=((T*(300+throttle*1400))%28)+'px';
    }
    const rpm=Math.round(1550+throttle*6100+(Math.random()-.5)*60);
    rpmShown+=(rpm-rpmShown)*.25; rpmEl.textContent=Math.round(rpmShown/10)*10;
  }
  // emit water (direction depends on the craft: jet ski washes left, the boat's prop washes right)
  if(running){
    const n=reduce?3:Math.round(10+throttle*26);
    const [nx,ny]=model.nozzle, dir=model.dir, base=dir<0?Math.PI:0;
    for(let i=0;i<n;i++){
      const sp=760+throttle*1500+Math.random()*300;
      const ang=base+(Math.random()-.5)*(.12+throttle*.08);
      parts.push({x:nx+Math.random()*6*dir,y:ny+(Math.random()-.5)*14,vx:Math.cos(ang)*sp,vy:Math.sin(ang)*sp+(Math.random()-.4)*40,life:0,max:.7+Math.random()*.6,r:3+Math.random()*7,k:Math.random()});
    }
  }
  // draw
  cx.setTransform(RES,0,0,RES,0,0);
  cx.clearRect(0,0,3900,3400);
  // water surface
  const wa=running?1:Math.max(0,(parts.length?.6:0));
  if(running||parts.length){
    cx.save();
    cx.beginPath();
    cx.moveTo(wx(-1500),wy(WATER));
    for(let x=-1500;x<=2400;x+=24){
      const y=WATER+Math.sin(x*.012+T*2.2)*5+Math.sin(x*.031-T*3.1)*2.5+(Math.abs(x-model.nozzle[0])<900?Math.sin(x*.05+T*9)*(2+throttle*6)*(1-Math.abs(x-model.nozzle[0])/900):0);
      cx.lineTo(wx(x),wy(y));
    }
    cx.strokeStyle=`rgba(20,110,140,${.7*wa})`; cx.lineWidth=3; cx.stroke();
    cx.lineTo(wx(2400),wy(1160)); cx.lineTo(wx(-1500),wy(1160)); cx.closePath();
    const g=cx.createLinearGradient(0,wy(WATER),0,wy(900));
    g.addColorStop(0,`rgba(23,143,170,${.22*wa})`); g.addColorStop(1,'rgba(23,143,170,0)');
    cx.fillStyle=g; cx.fill();
    cx.restore();
    // core stream (jet ski water-jet only)
    if(running && model.jet){
      const [nx,ny]=model.nozzle, len=420+throttle*700;
      const sg=cx.createLinearGradient(wx(nx),0,wx(nx-len),0);
      sg.addColorStop(0,'rgba(190,235,250,.95)'); sg.addColorStop(.6,'rgba(90,180,215,.55)'); sg.addColorStop(1,'rgba(90,180,215,0)');
      cx.fillStyle=sg;
      cx.beginPath();
      cx.moveTo(wx(nx),wy(ny-11));
      cx.quadraticCurveTo(wx(nx-len*.6),wy(ny-16-throttle*10),wx(nx-len),wy(ny+40+throttle*30));
      cx.quadraticCurveTo(wx(nx-len*.55),wy(ny+22+throttle*14),wx(nx),wy(ny+11));
      cx.fill();
      cx.strokeStyle='rgba(30,120,160,.45)'; cx.lineWidth=2; cx.stroke();
    }
  }
  // droplets
  for(let i=parts.length-1;i>=0;i--){
    const p=parts[i]; p.life+=dt;
    p.vy+=900*dt; p.vx*=(1-dt*.8);
    p.x+=p.vx*dt; p.y+=p.vy*dt;
    if(p.y>WATER+4){ p.y=WATER+4; p.vy*=-.18; p.vx*=.5; p.max=Math.min(p.max,p.life+.25); }
    const a=1-p.life/p.max;
    if(a<=0){parts.splice(i,1);continue;}
    const r=p.r*(1+p.life*1.6);
    cx.beginPath(); cx.arc(wx(p.x),wy(p.y),r,0,6.283);
    cx.fillStyle=p.k>.55?`rgba(255,255,255,${.85*a})`:`rgba(110,195,225,${.6*a})`;
    cx.fill();
    if(p.k>.55){cx.strokeStyle=`rgba(40,130,170,${.5*a})`;cx.lineWidth=1.5;cx.stroke();}
  }
  if(running||parts.length) raf=requestAnimationFrame(loop);
  else { raf=0; craft.style.transform=''; cx.clearRect(0,0,3900,3400); }
}

// throttle button
const gas=sr.getElementById('gas');
const down=e=>{e.preventDefault();target=1;gas.classList.add('held');if(!running)startEngine();if(soundOn){ensureAudio();if(audio)audio.on();}if(!raf)raf=requestAnimationFrame(loop);};
const up=()=>{target=0;gas.classList.remove('held');};
gas.addEventListener('pointerdown',down);
['pointerup','pointerleave','pointercancel'].forEach(ev=>gas.addEventListener(ev,up));
gas.addEventListener('keydown',e=>{if(e.key===' '||e.key==='Enter')down(e);});
gas.addEventListener('keyup',up);
gas.addEventListener('contextmenu',e=>e.preventDefault());

// synthesized engine sound
let audio=null;
function makeAudio(){
  const AC=window.AudioContext||window.webkitAudioContext; if(!AC) return null;
  const ac=new AC();
  const master=ac.createGain(); master.gain.value=0; master.connect(ac.destination);
  const lp=ac.createBiquadFilter(); lp.type='lowpass'; lp.frequency.value=500; lp.Q.value=4;
  const am=ac.createGain(); am.gain.value=.6; am.connect(lp); lp.connect(master);
  const o1=ac.createOscillator(); o1.type='sawtooth';
  const o2=ac.createOscillator(); o2.type='square';
  const g2=ac.createGain(); g2.gain.value=.35;
  o1.connect(am); o2.connect(g2); g2.connect(am);
  const lfo=ac.createOscillator(); lfo.type='sine'; const lg=ac.createGain(); lg.gain.value=.35;
  lfo.connect(lg); lg.connect(am.gain);
  const nb=ac.createBuffer(1,ac.sampleRate*2,ac.sampleRate), ch=nb.getChannelData(0);
  for(let i=0;i<ch.length;i++) ch[i]=Math.random()*2-1;
  const ns=ac.createBufferSource(); ns.buffer=nb; ns.loop=true;
  const bp=ac.createBiquadFilter(); bp.type='bandpass'; bp.frequency.value=1400; bp.Q.value=.8;
  const ng=ac.createGain(); ng.gain.value=0; ns.connect(bp); bp.connect(ng); ng.connect(master);
  // supercharger whine (GTX Limited only)
  const sc=ac.createOscillator(); sc.type='triangle'; const scg=ac.createGain(); scg.gain.value=0; sc.connect(scg); scg.connect(master);
  [o1,o2,lfo,ns,sc].forEach(n=>n.start());
  let live=false;
  (function tick(){
    const jet=model.jet, t=ac.currentTime;
    const f=jet?(36+throttle*115):(22+throttle*70);      // the boat's outboard idles deeper and slower than a jet ski
    o1.frequency.setTargetAtTime(f,t,.05); o2.frequency.setTargetAtTime(f*.5,t,.05);
    lfo.frequency.setTargetAtTime((jet?1.5:0.8)*f,t,.05);
    lp.frequency.setTargetAtTime(jet?(380+throttle*2200):(240+throttle*1200),t,.08);
    ng.gain.setTargetAtTime(live?(.12+throttle*.35):0,t,.1);
    const gtx=(model.src==='gtx');
    sc.frequency.setTargetAtTime(1900+throttle*5600,t,.06);
    scg.gain.setTargetAtTime(live&&gtx?(.012+throttle*.05):0,t,.1);
    requestAnimationFrame(tick);
  })();
  return {
    on(){live=true;ac.resume();master.gain.setTargetAtTime(.28,ac.currentTime,.25);},
    off(){live=false;master.gain.setTargetAtTime(0,ac.currentTime,.15);},
    stop(){live=false;master.gain.setTargetAtTime(0,ac.currentTime,.1);}
  };
}
const sb=sr.getElementById('sound');
let soundOn=true;   // engine sound on by default when you reach the section
sb.setAttribute('aria-pressed','true'); sb.textContent='Sound off';
function ensureAudio(){ if(!audio){ const a=makeAudio(); if(a){ const _on=a.on; a.on=()=>{ if(soundOn) _on(); }; audio=a; } } return audio; }
sb.onclick=()=>{
  soundOn=!soundOn;
  if(soundOn){ ensureAudio(); if(audio&&running) audio.on(); }
  else if(audio) audio.off();
  sb.setAttribute('aria-pressed',soundOn);
  sb.textContent=soundOn?'Sound off':'Sound on';
};
// browsers block audio until a user gesture, so start it on the first interaction while visible
function kickSound(){ if(soundOn&&running&&!offscreen){ ensureAudio(); if(audio) audio.on(); } }
['pointerdown','touchend','keydown','scroll'].forEach(ev=>addEventListener(ev,kickSound,{passive:true}));

// init + visibility: idle the engine while the ski is on screen, stop it off screen
sizeViewport();
applyCam(cam());
addEventListener('resize',()=>{ sizeViewport(); applyCam(cam()); });
if('IntersectionObserver' in window){
  new IntersectionObserver(function(es){
    if(es[0].isIntersecting){ offscreen=false; startEngine(); }
    else { offscreen=true; stopEngine(); if(raf){cancelAnimationFrame(raf); raf=0;} }
  },{rootMargin:'0px'}).observe(vp);
} else { startEngine(); }
})();

})();
</script>

