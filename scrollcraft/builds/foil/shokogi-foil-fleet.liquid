    { "type": "header", "content": "Footnote" },
    { "type": "textarea", "id": "outro", "label": "Footnote", "default": "Assembled and running. Scroll back up to take it apart; hold the throttle to rev the engine and the water jet. This is a graphic illustration — the mounting positions aren’t install instructions, and the RPM readout isn’t manufacturer data." },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 }
  ],
  "presets": [ { "name": "Foil rig assembly" } ]
}
