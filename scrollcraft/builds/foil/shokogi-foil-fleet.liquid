{%- comment -%}
  SHOKOGI foil — the owner's jet-ski assembly, dropped in as-is, inside a Shadow
  DOM so its CSS can't touch the theme (or be touched by it). Markup + CSS are
  verbatim from the prototype; only :root/body became :host, DOM lookups are
  scoped to the shadow root, and the 8 images point at the hosted copies instead
  of 1.5MB of embedded data. Edit freely from here.
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Secular+One&family=IBM+Plex+Sans+Hebrew:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500&display=swap">

<div id="skrig-host-{{ section.id }}"></div>
<template id="skrig-tpl-{{ section.id }}">
<style>
:host{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}:host{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}


:host{
  --paper:#f5f7f6;
  --paper-2:#eaefed;
  --ink:#15191b;
  --muted:#5a6569;
  --teal:#178f87;
  --orange:#e2681b;
  --grid:rgba(23,143,135,.09);
  --rule:rgba(21,25,27,.14);
  --f-display:"Secular One","IBM Plex Sans Hebrew",system-ui,sans-serif;
  --f-body:"IBM Plex Sans Hebrew",system-ui,-apple-system,"Segoe UI",Arial,sans-serif;
  --f-mono:"IBM Plex Mono",ui-monospace,Menlo,Consolas,monospace;
  color-scheme:light;
}
*{box-sizing:border-box}
:host{background:var(--paper);color:var(--ink);font-family:var(--f-body);font-size:16px;line-height:1.6;}
.page{
  background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);
  background-size:28px 28px;
}
.wrap{max-width:1180px;margin:0 auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.mono{font-family:var(--f-mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
h1,h2,h3{font-family:var(--f-display);font-weight:400;line-height:1.05;text-wrap:balance;margin:0}
p{margin:0}


.hero{padding-block:clamp(28px,6vw,64px) 24px}
.hero-top{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap;border-bottom:1px solid var(--rule);padding-bottom:10px}
.hero h1{font-size:clamp(44px,9vw,112px);margin-top:clamp(18px,4vw,36px);letter-spacing:-.01em}
.hero h1 em{font-style:normal;color:var(--teal)}
.hero-lede{max-width:56ch;margin-top:14px;color:var(--muted);font-size:clamp(16px,2vw,19px)}
.hero-img{position:relative;margin-top:clamp(16px,3vw,28px)}
.hero-img img{display:block;width:100%;height:auto}
.dim{position:absolute;inset:auto 2% 4% 2%;height:0;border-top:1px dashed var(--teal)}
.dim span{position:absolute;top:-22px;left:50%;transform:translateX(-50%);background:var(--paper);padding:0 8px}
.cta{display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-top:14px}
.btn.play{background:var(--ink);color:#fff;font-size:16px;padding:12px 20px}
.cue{display:flex;align-items:center;gap:10px}
.cue i{display:block;width:1px;height:34px;background:var(--ink);transform-origin:top;animation:cue 1.8s ease-in-out infinite}
@keyframes cue{0%{transform:scaleY(.2)}50%{transform:scaleY(1)}100%{transform:scaleY(.2)}}


.parts{padding-block:clamp(40px,7vw,90px)}
.sec-head{display:grid;gap:10px;margin-bottom:clamp(24px,4vw,44px)}
.sec-head h2{font-size:clamp(34px,5.4vw,64px)}
.sec-head p{color:var(--muted);max-width:60ch}
.part{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:clamp(16px,4vw,48px);align-items:center;padding-block:clamp(22px,4vw,40px);border-top:1px solid var(--rule)}
.part:nth-child(even) .plate{order:2}
.plate{position:relative;background:#fff;border:1px solid var(--rule);aspect-ratio:4/3;max-width:100%;display:grid;place-items:center;padding:clamp(14px,3vw,30px);overflow:hidden}
.plate::before,.plate::after{content:"";position:absolute;width:18px;height:18px;border:2px solid var(--ink)}
.plate::before{top:8px;right:8px;border-left:0;border-bottom:0}
.plate::after{bottom:8px;left:8px;border-right:0;border-top:0}
.plate img{max-width:100%;max-height:100%;object-fit:contain;transition:transform .5s cubic-bezier(.2,.7,.2,1)}
.plate:hover img{transform:scale(1.04) rotate(-1deg)}
.plate .tag{position:absolute;top:10px;left:14px}
.ptext{display:grid;gap:10px;min-width:0}
.ptext h3{font-size:clamp(28px,4vw,44px)}
.ptext .brand{font-family:var(--f-mono);font-size:13px;color:var(--teal);letter-spacing:.06em}
.ptext p{color:var(--ink);max-width:46ch}
.spec{display:grid;grid-template-columns:auto 1fr;gap:4px 14px;margin-top:6px;font-size:14px;border-top:1px dashed var(--rule);padding-top:10px}
.spec dt{font-family:var(--f-mono);font-size:12px;color:var(--muted);letter-spacing:.06em;padding-top:2px}
.spec dd{margin:0}
.hulls{display:grid;grid-template-columns:1fr 1fr;gap:clamp(12px,2vw,24px)}
.hulls .plate{aspect-ratio:2/1.15}


#assembly{position:relative;height:440svh}
.static #assembly{height:auto}
.static .viewport{position:relative}
.viewport{position:sticky;top:0;height:100svh;overflow:hidden;background:var(--paper);background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);background-size:28px 28px;direction:ltr}
.world{position:absolute;left:0;top:0;width:3900px;height:3400px;transform-origin:0 0}
.craft{position:absolute;inset:0}
.world img{position:absolute;display:block;user-select:none;-webkit-user-drag:none;pointer-events:none}
.p{position:absolute;left:0;top:0;transform-origin:50% 50%}
.lbl{transition:none}
.p img{position:static;width:100%;height:auto}
.lbl{position:absolute;font-family:var(--f-mono);font-size:26px;letter-spacing:.06em;color:var(--ink);white-space:nowrap;direction:ltr}
.lbl b{display:block;font-family:var(--f-display);font-weight:400;font-size:44px;letter-spacing:0}
.lbl::before{content:"";position:absolute;top:-16px;left:0;width:60px;height:3px;background:var(--orange)}
#hull{left:1500px;top:1200px;width:1774px;height:887px}
#engineClip{left:1500px;top:1200px;width:1774px;height:887px}
.ov{position:absolute;pointer-events:none;opacity:0;transition:opacity .4s}
#glow{background:radial-gradient(closest-side,rgba(255,140,40,.75),rgba(255,120,30,.25) 60%,transparent);mix-blend-mode:screen}
#shaft{background:repeating-linear-gradient(90deg,transparent 0 12px,rgba(255,255,255,.75) 12px 16px);mix-blend-mode:screen;background-size:28px 100%}
#rope-line{position:absolute;left:0;top:0;width:3900px;height:3400px;overflow:visible;pointer-events:none}
#fx{position:absolute;left:0;top:0;width:3900px;height:3400px;pointer-events:none}

.hud{position:absolute;inset:auto 0 0 0;padding:12px max(16px,env(safe-area-inset-right,0px)) calc(14px + env(safe-area-inset-bottom,0px)) max(16px,env(safe-area-inset-left,0px));direction:ltr;display:grid;gap:10px;background:linear-gradient(to top,var(--paper) 55%,rgba(245,247,246,0))}
.steps{display:flex;gap:6px;flex-wrap:wrap;list-style:none;margin:0;padding:0}
.steps li{font-family:var(--f-mono);font-size:11px;letter-spacing:.06em;padding:4px 9px;border:1px solid var(--rule);background:#fff;color:var(--muted);transition:all .25s}
.steps li.on{background:var(--ink);color:#fff;border-color:var(--ink)}
.steps li.done{color:var(--teal);border-color:var(--teal)}
.caption{font-family:var(--f-display);font-size:clamp(20px,3.2vw,34px);line-height:1.1;min-height:1.1em}
.topbar{position:absolute;top:calc(12px + env(safe-area-inset-top,0px));right:max(16px,env(safe-area-inset-right,0px));left:max(16px,env(safe-area-inset-left,0px));display:flex;justify-content:space-between;align-items:center;gap:10px;direction:ltr;flex-wrap:wrap}
.seg{display:inline-flex;border:1px solid var(--ink);background:#fff}
.seg button{font:500 13px var(--f-mono);letter-spacing:.04em;padding:7px 12px;border:0;background:transparent;color:var(--ink);cursor:pointer}
.seg button[aria-pressed="true"]{background:var(--ink);color:#fff}
.controls{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.btn{font:500 14px var(--f-body);padding:10px 16px;border:1px solid var(--ink);background:#fff;color:var(--ink);cursor:pointer;touch-action:none;user-select:none;-webkit-user-select:none}
.btn.gas{background:var(--orange);border-color:var(--orange);color:#fff;min-width:96px}
.btn.gas.held{background:#b84f10}
.btn:focus-visible,.seg button:focus-visible{outline:3px solid var(--teal);outline-offset:2px}
.rpm{font-family:var(--f-mono);font-variant-numeric:tabular-nums;font-size:14px;padding:9px 12px;border:1px solid var(--rule);background:#fff;min-width:140px;text-align:center}
.rpm b{font-size:18px;font-weight:500}
.run-ui{display:none}
.running .run-ui{display:flex}

.outro{padding-block:clamp(40px,7vw,80px)}
.outro p{color:var(--muted);max-width:62ch}
.outro h2{font-size:clamp(30px,4.6vw,52px);margin-bottom:12px}

@media (max-width:760px){
  .part{grid-template-columns:1fr}
  .part:nth-child(even) .plate{order:0}
  .hulls{grid-template-columns:1fr}
  .lbl{font-size:34px}.lbl b{font-size:60px}
}
@media (prefers-reduced-motion:reduce){
  .cue i{animation:none}
  .plate img{transition:none}
}

</style>
<div class="page" dir="ltr" lang="en">

<section id="assembly" aria-label="Assembly animation">
  <div class="viewport" id="vp">
    <div class="world" id="world">
      <div class="craft" id="craft">
        <div class="p" id="p-pylon"><img data-img="pylon" alt=""></div>
        <img id="hull" data-img="wake" alt="">
        <img id="engineClip" data-img="wake" alt="">
        <div class="ov" id="glow"></div>
        <div class="ov" id="shaft"></div>
        <div class="p" id="p-arch"><img data-img="sidetube" alt=""></div>
        <div class="p" id="p-board"><img data-img="sled" alt=""></div>
        <svg id="rope-line" viewBox="0 0 3900 3400" aria-hidden="true">
          <path id="rope-path" d="" fill="none" stroke="#f2c21b" stroke-width="9" stroke-linecap="round"/>
          <path id="rope-path2" d="" fill="none" stroke="#fff" stroke-width="3" stroke-dasharray="6 14" stroke-linecap="round"/>
        </svg>
        <div class="p" id="p-rope"><img data-img="rope" alt=""></div>
        <canvas id="fx"></canvas>
        <div class="lbl" id="l-pylon"><b>Tow pylon</b>BRP</div>
        <div class="lbl" id="l-rope"><b>Rope</b>ARMSTRONG</div>
        <div class="lbl" id="l-board"><b>Sled</b>JETTECH</div>
        <div class="lbl" id="l-arch"><b>Floats</b>JAIN</div>
      </div>
    </div>

    <div class="topbar">
      <div class="seg" role="group" aria-label="Choose model">
        <button type="button" id="m-wake" aria-pressed="true">Wake Pro</button>
        <button type="button" id="m-gtx" aria-pressed="false">GTX Limited</button>
      </div>
      <div class="controls"><button type="button" class="btn" id="play-stage">▶ Play from start</button><span class="mono" id="stepnum">Exploded view</span></div>
    </div>

    <div class="hud">
      <ol class="steps" id="steps">
        <li>Pylon</li><li>Rope</li><li>Sled</li><li>Floats</li><li>Ignition</li>
      </ol>
      <div class="caption" id="caption">All parts exploded. Scroll to assemble.</div>
      <div class="controls run-ui">
        <div class="rpm" aria-live="off">RPM <b id="rpm">0</b></div>
        <button type="button" class="btn gas" id="gas" aria-label="Throttle, hold down">Throttle ▲</button>
        <button type="button" class="btn" id="sound" aria-pressed="false">Sound on</button>
      </div>
    </div>
  </div>
</section>

<section class="outro wrap">
  <h2>Assembled and running</h2>
  <p>Scroll back up to take it apart. Hold the throttle to raise the RPM and the water jet. This animation is a graphic illustration — the mounting positions aren't install instructions, and the RPM readout isn't manufacturer data.</p>
</section>

</div>
</template>

<script>
(function(){
  var host=document.getElementById('skrig-host-{{ section.id }}');
  if(!host||host.dataset.ready) return; host.dataset.ready='1';
  var tpl=document.getElementById('skrig-tpl-{{ section.id }}');
  if(!host.attachShadow){ host.appendChild(tpl.content.cloneNode(true)); return; }
  var sr=host.attachShadow({mode:'open'});
  sr.appendChild(tpl.content.cloneNode(true));

const IMG={arch:"https://cdn.shopify.com/s/files/1/0116/5364/4354/files/sk-jet-arch.webp?v=1792881173",board:"https://cdn.shopify.com/s/files/1/0116/5364/4354/files/sk-jet-board.webp?v=1792881173",gtx:"https://cdn.shopify.com/s/files/1/0116/5364/4354/files/sk-jet-gtx.webp?v=1792879218",pylon:"https://cdn.shopify.com/s/files/1/0116/5364/4354/files/sk-jet-pylon.webp?v=1792879218",rope:"https://cdn.shopify.com/s/files/1/0116/5364/4354/files/sk-jet-rope.webp?v=1792879218",sidetube:"https://cdn.shopify.com/s/files/1/0116/5364/4354/files/sk-jet-floats.webp?v=1792879218",sled:"https://cdn.shopify.com/s/files/1/0116/5364/4354/files/sk-jet-sled.webp?v=1792879218",wake:"https://cdn.shopify.com/s/files/1/0116/5364/4354/files/sk-jet-wake.webp?v=1792879218"};
const MOBILE=matchMedia('(max-width:760px)').matches||/iPhone|iPad|iPod|Android/.test(navigator.userAgent);
const IW=MOBILE?820:1280;
const WIDE=u=>(!u||u.slice(0,5)==='data:')?u:u+(u.indexOf('?')>-1?'&':'?')+'width='+IW;
for(const im of sr.querySelectorAll('img[data-img]')) im.src=WIDE(IMG[im.dataset.img]);
(function(){
const OX=1500, OY=1200;               // image coords -> world coords
const wx=x=>x+OX, wy=y=>y+OY;
const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const lerp=(a,b,t)=>a+(b-a)*t;
const io=t=>t<.5?4*t*t*t:1-Math.pow(-2*t+2,3)/2;      // ease in-out cubic
const seg=(t,a,b)=>clamp((t-a)/(b-a),0,1);

const MODELS={
  wake:{src:'wake',nozzle:[52,655],engine:[530,545,905,765],shaft:[300,645,525,672]},
  gtx:{src:'gtx',nozzle:[68,655],engine:[520,545,905,765],shaft:[300,640,515,670]}
};
let model=MODELS.wake;

// parts: natural aspect (h/w), start [cx,cy,w,rot], final [cx,cy,w,rot], timing [t0,t1]
const PARTS={
  pylon:{ar:1144/1000, s:[-430,330,200,0],  f:[338,382,190,0],  t:[.7,1.8],  lift:140},
  rope: {ar:475/1000,  s:[-390,820,280,-4], f:[-1170,760,420,0], t:[1.9,3.0], lift:60},
  board:{ar:1087/539,  s:[2130,360,150,6],  f:[-310,690,500,-90], t:[3.7,5.1], lift:300, tilt:66, slope:-7},
  arch: {ar:955/129,   s:[2300,640,50,-90], f:[900,505,170,-91.8],t:[5.3,6.5], lift:80, stretch:1.36}
};
const LBL_L={pylon:[-430,520],rope:[-390,940],board:[2130,520],arch:[2300,900]};
const LBL_T={pylon:[.5,.8],rope:[1.8,2.1],board:[3.5,3.8],arch:[5.2,5.5]};
// portrait screens: parts float above / below the hull instead of beside it
const START_P={pylon:[360,-400,220,0],board:[1300,-420,150,6],rope:[520,1060,360,-4],arch:[1320,980,52,-90]};
const LBL_P={pylon:[360,-200],board:[1300,-200],rope:[520,1230],arch:[1320,1190]};
const START_L={}; for(const k in PARTS) START_L[k]=PARTS[k].s.slice();
let portrait=null;
function layout(){
  const p=vp.clientWidth/vp.clientHeight<0.9;
  if(p===portrait) return; portrait=p;
  const LB=p?LBL_P:LBL_L;
  for(const k in PARTS){
    PARTS[k].s=(p?START_P:START_L)[k].slice();
    const P=PARTS[k];
    el[k].style.width=P.s[2]+'px';
    lb[k].style.left=(wx(LB[k][0])-P.s[2]/2)+'px';
    lb[k].style.top=wy(LB[k][1])+'px';
  }
}

const world=sr.getElementById('world'), vp=sr.getElementById('vp');
const el={}, lb={};
for(const k in PARTS){
  const P=PARTS[k];
  el[k]=sr.getElementById('p-'+k);
  el[k].style.width=P.s[2]+'px';
  lb[k]=sr.getElementById('l-'+k);
}
function placePart(k,t){
  const P=PARTS[k], e=io(seg(t,P.t[0],P.t[1]));
  const w=P.s[2], h=w*P.ar;
  const cx=lerp(P.s[0],P.f[0],e), cy=lerp(P.s[1],P.f[1],e)-Math.sin(Math.PI*e)*P.lift;
  const sc=lerp(1,P.f[2]/w,e), rot=lerp(P.s[3],P.f[3],e);
  const tilt=(P.tilt||0)*e, slope=(P.slope||0)*e, st=lerp(1,P.stretch||1,e);
  el[k].style.transform=`translate(${wx(cx)-w/2}px,${wy(cy)-h/2}px)`+(tilt?` rotate(${slope}deg) perspective(1800px) rotateX(${tilt}deg)`:'')+` rotate(${rot}deg) scale(${sc},${sc*st})`;
  const L=LBL_T[k]; lb[k].style.opacity=1-seg(t,L[0],L[1]);
}
// overlays
function placeOverlays(){
  const [ex1,ey1,ex2,ey2]=model.engine, [sx1,sy1,sx2,sy2]=model.shaft;
  Object.assign(sr.getElementById('glow').style,{left:wx(ex1-40)+'px',top:wy(ey1-30)+'px',width:(ex2-ex1+80)+'px',height:(ey2-ey1+60)+'px'});
  Object.assign(sr.getElementById('shaft').style,{left:wx(sx1)+'px',top:wy(sy1)+'px',width:(sx2-sx1)+'px',height:(sy2-sy1)+'px'});
  sr.getElementById('engineClip').style.clipPath=`inset(${ey1}px ${1774-ex2}px ${887-ey2}px ${ex1}px)`;
}
placeOverlays();

// camera
const CAMS_P={
  E:{x:-80,y:-1060,w:1940,h:2950},
  R1:{x:-520,y:-140,w:1180,h:1180},
  R2:{x:-1450,y:100,w:1750,h:1000},
  F:{x:-1450,y:-700,w:3400,h:2200},
  R4:{x:-60,y:60,w:1950,h:1000},
  F2:{x:-1450,y:200,w:3400,h:700},
  EN:{x:-1450,y:80,w:2250,h:1000}
};
const CAMS_L={
  E:{x:-1000,y:-480,w:3400,h:1640},
  R1:{x:-760,y:40,w:1500,h:820},
  R2:{x:-1500,y:200,w:1950,h:800},
  F:{x:-1450,y:0,w:3750,h:1000},
  R4:{x:-60,y:200,w:2000,h:700},
  F2:{x:-1450,y:140,w:3400,h:780},
  EN:{x:-1450,y:280,w:2550,h:720}
};
const CAMK=[[0,'E'],[.5,'E'],[1.3,'R1'],[1.9,'R1'],[2.5,'R2'],[3.5,'R2'],[4.3,'F'],[5.2,'F'],[6.2,'R4'],[6.7,'R4'],[7.6,'F2'],[7.8,'F2'],[8.7,'EN'],[9.4,'EN']];
const TEND=9.4;
const CAM_FIX_L={x:-740,y:-150,w:3260,h:1200};
const CAM_FIX_P={x:-760,y:-310,w:2700,h:1560};
const CAMS=()=>portrait?CAMS_P:CAMS_L;
function camAt(t){ return portrait?CAM_FIX_P:CAM_FIX_L; }
function applyCam(cam){
  const W=vp.clientWidth, H=vp.clientHeight;
  const topPad=56, botPad=Math.min(190,H*.26);
  const ah=Math.max(120,H-topPad-botPad);
  const s=Math.min(W/cam.w, ah/cam.h);
  const tx=(W-cam.w*s)/2 - wx(cam.x)*s;
  const ty=topPad+(ah-cam.h*s)/2 - wy(cam.y)*s;
  world.style.transform=`translate(${tx}px,${ty}px) scale(${s})`;
}

// rope line (pylon top -> coil)
const ropeA=[338,282], ropeB=[-1010,690];
const rp=sr.getElementById('rope-path'), rp2=sr.getElementById('rope-path2');
const d=`M${wx(ropeA[0])},${wy(ropeA[1])} Q${wx(-330)},${wy(540)} ${wx(ropeB[0])},${wy(ropeB[1])}`;
rp.setAttribute('d',d); rp2.setAttribute('d',d);
const RL=rp.getTotalLength();
rp.style.strokeDasharray=RL;

// HUD
const stepsEl=[...sr.querySelectorAll('#steps li')];
const caption=sr.getElementById('caption'), stepnum=sr.getElementById('stepnum');
const CAPS=['All parts exploded. Scroll, or press ▶ Play.','The tow pylon drops onto the rear deck','The rope ties to the top of the pylon','The sled locks on at the stern','The floats hug the hull sides','Running. Hold the throttle.'];
const STEPT=[.15,1.9,3.6,5.2,8.6];
let curStep=-1;
function setStep(i){
  if(i===curStep) return; curStep=i;
  stepsEl.forEach((li,j)=>{li.classList.toggle('on',j===i-1);li.classList.toggle('done',j<i-1);});
  caption.textContent=CAPS[i]||'';
  stepnum.textContent=i===0?'Exploded view':`Step ${i} of 5`;
}

// scroll-driven timeline (smoothed)
const sec=sr.getElementById('assembly');
let tCur=0, tTarget=0, sraf=0;
function render(t){
  applyCam(camAt(t));
  for(const k in PARTS) placePart(k,t);
  rp.style.strokeDashoffset=RL*(1-io(seg(t,2.8,3.5)));
  rp2.style.opacity=seg(t,3.3,3.5);
  let s=0; STEPT.forEach((v,i)=>{ if(t>=v) s=i+1; }); setStep(s);
  if(t>=8.65) startEngine(); else stopEngine();
}
// play mode: runs the whole sequence on a clock, independent of scrolling
let mode='scroll', playing=false, playStart=0;
const PLAY_MS=reduce?6000:13000;
function play(){
  playing=true; playStart=performance.now();
  if(mode==='scroll'){ scrollTo({top:sec.getBoundingClientRect().top+scrollY,behavior:'instant'}); }
  requestAnimationFrame(playTick);
}
function playTick(now){
  if(!playing) return;
  const k=clamp((now-playStart)/PLAY_MS,0,1);
  tCur=tTarget=k*TEND; render(tCur);
  if(k<1){ requestAnimationFrame(playTick); return; }
  playing=false;
  if(mode==='scroll'){ const r=sec.getBoundingClientRect(); scrollTo({top:r.top+scrollY+r.height-innerHeight,behavior:'instant'}); }
}
['wheel','touchstart','keydown'].forEach(ev=>addEventListener(ev,e=>{
  if(!playing||mode!=='scroll') return;
  if(e.target.closest&&e.target.closest('button')) return;
  playing=false; readScroll();
},{passive:true}));
function readScroll(){
  if(playing||mode!=='scroll') return;
  const r=sec.getBoundingClientRect(), span=r.height-innerHeight;
  tTarget=clamp(-r.top/span,0,1)*TEND;
  if(!sraf) sraf=requestAnimationFrame(step);
}
function step(){
  tCur+= reduce ? (tTarget-tCur) : (tTarget-tCur)*.14;
  if(Math.abs(tTarget-tCur)<.0015) tCur=tTarget;
  render(tCur);
  sraf = tCur!==tTarget ? requestAnimationFrame(step) : 0;
}
addEventListener('scroll',readScroll,{passive:true});
if('IntersectionObserver' in window){ new IntersectionObserver(function(es){ offscreen=!es[0].isIntersecting; if(offscreen){ stopEngine(); if(raf){cancelAnimationFrame(raf); raf=0;} } },{rootMargin:'0px'}).observe(vp); }
addEventListener('resize',()=>{ if(mode==='static') sizeStatic(); layout(); render(tCur); });
// some viewers grow the frame to the page's full height, so the page never scrolls itself.
// there the stage becomes a normal block and the sequence plays on its own.
function sizeStatic(){
  const W=document.documentElement.clientWidth;
  const h=Math.round(clamp(W<700?W*1.55:W*0.56,460,880));
  vp.style.height=h+'px';
}
function checkMode(){
  const se=document.scrollingElement||document.documentElement;
  const canScroll=se.scrollHeight-innerHeight>innerHeight*2 && innerHeight<1800;
  if(canScroll||mode==='static') return;
  mode='static'; sr.querySelector('.page').classList.add('static');
  var _hero=sr.querySelector('.hero'); if(_hero)_hero.after(sec);
  sizeStatic(); portrait=null; layout(); render(0);
  setTimeout(play,600);
}
var _ph=sr.getElementById('play-hero'); if(_ph)_ph.onclick=()=>play();
sr.getElementById('play-stage').onclick=()=>play();


// model switch
function setModel(name){
  model=MODELS[name];
  sr.getElementById('hull').src=WIDE(IMG[model.src]);
  sr.getElementById('engineClip').src=WIDE(IMG[model.src]);
  sr.getElementById('m-wake').setAttribute('aria-pressed',name==='wake');
  sr.getElementById('m-gtx').setAttribute('aria-pressed',name==='gtx');
  placeOverlays();
}
sr.getElementById('m-wake').onclick=()=>setModel('wake');
sr.getElementById('m-gtx').onclick=()=>setModel('gtx');

// engine + water
const cv=sr.getElementById('fx'), cx=cv.getContext('2d');
const RES=MOBILE?0.3:0.5; if(!MOBILE){ cv.width=3900*RES; cv.height=3400*RES; }
let running=false, throttle=0, target=0, parts=[], raf=0, t0=performance.now(), rpmShown=0, offscreen=false;
const craft=sr.getElementById('craft'), clip=sr.getElementById('engineClip');
const glow=sr.getElementById('glow'), shaft=sr.getElementById('shaft');
  if(MOBILE){ glow.style.mixBlendMode='normal'; shaft.style.mixBlendMode='normal'; }
const rpmEl=sr.getElementById('rpm');
function startEngine(){
  if(running||offscreen) return; running=true; vp.classList.add('running');
  shaft.style.opacity=1;
  if(!raf) raf=requestAnimationFrame(loop);
  if(audio) audio.on();
}
function stopEngine(){
  if(!running) return; running=false; vp.classList.remove('running');
  glow.style.opacity=0; shaft.style.opacity=0; target=0;
  if(audio) audio.off();
}
const WATER=742;
function loop(now){
  const dt=Math.min(.05,(now-t0)/1000); t0=now;
  throttle+=(target-throttle)*Math.min(1,dt*(target>throttle?3:1.6));
  const T=now/1000;
  // shake + engine jitter
  if(running && !reduce){
    const a=.6+throttle*1.4;
    craft.style.transform=`translate(${(Math.random()-.5)*a}px,${(Math.random()-.5)*a}px)`;
    const j=1.2+throttle*2.5;
    clip.style.transform=`translate(${(Math.random()-.5)*j}px,${(Math.random()-.5)*j}px)`;
  } else { craft.style.transform=''; clip.style.transform=''; }
  if(running){
    glow.style.opacity=(.55+throttle*.4+Math.random()*.12).toFixed(2);
    shaft.style.backgroundPositionX=((T*(300+throttle*1400))%28)+'px';
    const rpm=Math.round(1550+throttle*6100+(Math.random()-.5)*60);
    rpmShown+=(rpm-rpmShown)*.25; rpmEl.textContent=Math.round(rpmShown/10)*10;
  }
  if(MOBILE){ if(running) raf=requestAnimationFrame(loop); else { raf=0; craft.style.transform=''; } return; }
  // emit water
  if(running){
    const n=reduce?3:Math.round(10+throttle*26);
    const [nx,ny]=model.nozzle;
    for(let i=0;i<n;i++){
      const sp=760+throttle*1500+Math.random()*300;
      const ang=Math.PI+(Math.random()-.5)*(.12+throttle*.08)-.03;
      parts.push({x:nx+Math.random()*6,y:ny+(Math.random()-.5)*14,vx:Math.cos(ang)*sp,vy:Math.sin(ang)*sp+(Math.random()-.4)*40,life:0,max:.7+Math.random()*.6,r:3+Math.random()*7,k:Math.random()});
    }
  }
  // draw
  cx.setTransform(RES,0,0,RES,0,0);
  cx.clearRect(0,0,3900,3400);
  // water surface
  const wa=running?1:Math.max(0,(parts.length?.6:0));
  if(running||parts.length){
    cx.save();
    cx.beginPath();
    cx.moveTo(wx(-1500),wy(WATER));
    for(let x=-1500;x<=2400;x+=24){
      const y=WATER+Math.sin(x*.012+T*2.2)*5+Math.sin(x*.031-T*3.1)*2.5+(x<60&&x>-900?Math.sin(x*.05+T*9)*(2+throttle*6)*(1-(60-x)/960):0);
      cx.lineTo(wx(x),wy(y));
    }
    cx.strokeStyle=`rgba(20,110,140,${.7*wa})`; cx.lineWidth=3; cx.stroke();
    cx.lineTo(wx(2400),wy(1160)); cx.lineTo(wx(-1500),wy(1160)); cx.closePath();
    const g=cx.createLinearGradient(0,wy(WATER),0,wy(900));
    g.addColorStop(0,`rgba(23,143,170,${.22*wa})`); g.addColorStop(1,'rgba(23,143,170,0)');
    cx.fillStyle=g; cx.fill();
    cx.restore();
    // core stream
    if(running){
      const [nx,ny]=model.nozzle, len=420+throttle*700;
      const sg=cx.createLinearGradient(wx(nx),0,wx(nx-len),0);
      sg.addColorStop(0,'rgba(190,235,250,.95)'); sg.addColorStop(.6,'rgba(90,180,215,.55)'); sg.addColorStop(1,'rgba(90,180,215,0)');
      cx.fillStyle=sg;
      cx.beginPath();
      cx.moveTo(wx(nx),wy(ny-11));
      cx.quadraticCurveTo(wx(nx-len*.6),wy(ny-16-throttle*10),wx(nx-len),wy(ny+40+throttle*30));
      cx.quadraticCurveTo(wx(nx-len*.55),wy(ny+22+throttle*14),wx(nx),wy(ny+11));
      cx.fill();
      cx.strokeStyle='rgba(30,120,160,.45)'; cx.lineWidth=2; cx.stroke();
    }
  }
  // droplets
  for(let i=parts.length-1;i>=0;i--){
    const p=parts[i]; p.life+=dt;
    p.vy+=900*dt; p.vx*=(1-dt*.8);
    p.x+=p.vx*dt; p.y+=p.vy*dt;
    if(p.y>WATER+4){ p.y=WATER+4; p.vy*=-.18; p.vx*=.5; p.max=Math.min(p.max,p.life+.25); }
    const a=1-p.life/p.max;
    if(a<=0){parts.splice(i,1);continue;}
    const r=p.r*(1+p.life*1.6);
    cx.beginPath(); cx.arc(wx(p.x),wy(p.y),r,0,6.283);
    cx.fillStyle=p.k>.55?`rgba(255,255,255,${.85*a})`:`rgba(110,195,225,${.6*a})`;
    cx.fill();
    if(p.k>.55){cx.strokeStyle=`rgba(40,130,170,${.5*a})`;cx.lineWidth=1.5;cx.stroke();}
  }
  if(running||parts.length) raf=requestAnimationFrame(loop);
  else { raf=0; craft.style.transform=''; cx.clearRect(0,0,3900,3400); }
}

// throttle button
const gas=sr.getElementById('gas');
const down=e=>{e.preventDefault();target=1;gas.classList.add('held');if(audio)audio.on();if(!raf)raf=requestAnimationFrame(loop);};
const up=()=>{target=0;gas.classList.remove('held');};
gas.addEventListener('pointerdown',down);
['pointerup','pointerleave','pointercancel'].forEach(ev=>gas.addEventListener(ev,up));
gas.addEventListener('keydown',e=>{if(e.key===' '||e.key==='Enter')down(e);});
gas.addEventListener('keyup',up);
gas.addEventListener('contextmenu',e=>e.preventDefault());

// synthesized engine sound
let audio=null;
function makeAudio(){
  const AC=window.AudioContext||window.webkitAudioContext; if(!AC) return null;
  const ac=new AC();
  const master=ac.createGain(); master.gain.value=0; master.connect(ac.destination);
  const lp=ac.createBiquadFilter(); lp.type='lowpass'; lp.frequency.value=500; lp.Q.value=4;
  const am=ac.createGain(); am.gain.value=.6; am.connect(lp); lp.connect(master);
  const o1=ac.createOscillator(); o1.type='sawtooth';
  const o2=ac.createOscillator(); o2.type='square';
  const g2=ac.createGain(); g2.gain.value=.35;
  o1.connect(am); o2.connect(g2); g2.connect(am);
  const lfo=ac.createOscillator(); lfo.type='sine'; const lg=ac.createGain(); lg.gain.value=.35;
  lfo.connect(lg); lg.connect(am.gain);
  const nb=ac.createBuffer(1,ac.sampleRate*2,ac.sampleRate), ch=nb.getChannelData(0);
  for(let i=0;i<ch.length;i++) ch[i]=Math.random()*2-1;
  const ns=ac.createBufferSource(); ns.buffer=nb; ns.loop=true;
  const bp=ac.createBiquadFilter(); bp.type='bandpass'; bp.frequency.value=1400; bp.Q.value=.8;
  const ng=ac.createGain(); ng.gain.value=0; ns.connect(bp); bp.connect(ng); ng.connect(master);
  [o1,o2,lfo,ns].forEach(n=>n.start());
  let live=false;
  (function tick(){
    const f=36+throttle*115, t=ac.currentTime;
    o1.frequency.setTargetAtTime(f,t,.05); o2.frequency.setTargetAtTime(f*.5,t,.05);
    lfo.frequency.setTargetAtTime(f*1.5,t,.05);
    lp.frequency.setTargetAtTime(380+throttle*2200,t,.08);
    ng.gain.setTargetAtTime(live?(.12+throttle*.35):0,t,.1);
    requestAnimationFrame(tick);
  })();
  return {
    on(){live=true;ac.resume();master.gain.setTargetAtTime(.28,ac.currentTime,.25);},
    off(){live=false;master.gain.setTargetAtTime(0,ac.currentTime,.15);},
    stop(){live=false;master.gain.setTargetAtTime(0,ac.currentTime,.1);}
  };
}
const sb=sr.getElementById('sound');
let soundOn=false;
sb.onclick=()=>{
  soundOn=!soundOn;
  if(soundOn){
    if(!audio){ const a=makeAudio(); if(a){ const on=a.on; a.on=()=>{ if(soundOn) on(); }; audio=a; } }
    if(audio&&running) audio.on();
  } else if(audio) audio.off();
  sb.setAttribute('aria-pressed',soundOn);
  sb.textContent=soundOn?'Sound off':'Sound on';
};
layout(); readScroll(); render(tCur);
setTimeout(checkMode,700);
})();

})();
</script>

