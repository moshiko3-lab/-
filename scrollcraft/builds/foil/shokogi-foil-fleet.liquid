{%- comment -%}
  SHOKOGI — "The Setup": the full tow-in rig (ski, rope, board, pylon, arch)
  converges onto the jet ski on scroll. Self-contained section on the two foil
  pages. Loads sk.css + the foil polish layers (skplusfoil.css + skplusfoil2.css,
  scoped to .skp — only ever loaded here) + the brand font weights, so the whole
  foil page also gets the polish. Degrades to the assembled scene without JS.
{%- endcomment -%}
{{ 'sk.css' | asset_url | stylesheet_tag }}
{{ 'skplusfoil.css' | asset_url | stylesheet_tag }}
{{ 'skplusfoil2.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Figtree:wght@400;500;600;700&display=swap">
<div class="skp">
  <div class="sec"><div class="wrap">
    <div class="kicker" style="text-align:center">the setup</div>
    <h2>Everything Comes Together</h2>
    <p class="lead">Our full tow-in rig &mdash; ski, line, board, pylon and arch, dialed and ready for your session.</p>
    <div class="setup" id="skf-setup">
      <div class="stage">
        <div class="pc ski"><img src="https://cdn.shopify.com/s/files/1/0116/5364/4354/files/shokogi-foil-ski.webp?v=1792877437" width="1200" height="600" loading="lazy" alt="Sea-Doo GTX Limited 300 tow-in jet ski"></div>
        <div class="pc rope"><img src="https://cdn.shopify.com/s/files/1/0116/5364/4354/files/shokogi-foil-rope.webp?v=1792877437" width="1200" height="600" loading="lazy" alt="Armstrong tow rope and handle"></div>
        <div class="pc arch"><img src="https://cdn.shopify.com/s/files/1/0116/5364/4354/files/shokogi-foil-arch.webp?v=1792877437" width="1100" height="733" loading="lazy" alt="JAIN inflatable grab arch"></div>
        <div class="pc pylon"><img src="https://cdn.shopify.com/s/files/1/0116/5364/4354/files/shokogi-foil-pylon.webp?v=1792877437" width="950" height="950" loading="lazy" alt="BRP tow pylon"></div>
        <div class="pc board"><img src="https://cdn.shopify.com/s/files/1/0116/5364/4354/files/shokogi-foil-board.webp?v=1792877437" width="950" height="950" loading="lazy" alt="JETTECH tow board"></div>
      </div>
      <div class="legend">
        <span><b>Sea-Doo</b> GTX Limited 300</span>
        <span><b>Armstrong</b> Tow Rope</span>
        <span><b>JETTECH</b> Tow Board</span>
        <span><b>BRP</b> Tow Pylon</span>
        <span><b>JAIN</b> Grab Arch</span>
      </div>
    </div>
  </div></div>
</div>
<script>
(function(){
  var el=document.getElementById('skf-setup');
  if(!el) return;
  el.classList.add('ready');
  var done=false, play=function(){ if(done){return;} done=true; el.classList.add('go'); };
  if(!('IntersectionObserver' in window)){ play(); return; }
  var io=new IntersectionObserver(function(es){es.forEach(function(e){ if(e.isIntersecting){ play(); io.disconnect(); } });},{threshold:0.35});
  io.observe(el);
})();
</script>
{% schema %}
{ "name": "Foil Setup", "tag": "section", "settings": [], "presets": [ { "name": "Foil Setup" } ] }
{% endschema %}
