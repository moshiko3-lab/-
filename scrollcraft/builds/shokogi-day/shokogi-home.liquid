{%- comment -%} SHOKOGI Home — the live home page, original layout (text below the video, original type), with gentle reveals + animated ocean waves. {%- endcomment -%}
{{ 'sk.css' | asset_url | stylesheet_tag }}
{{ 'skplus.css' | asset_url | stylesheet_tag }}
{%- assign hv = section.settings.hero_video -%}
<div class="skp sk2">

  <!-- HERO (video, text below — as the original) -->
  <div class="herofull">
    <video autoplay muted loop playsinline preload="auto"{% if hv != blank and hv.preview_image %} poster="{{ hv.preview_image | image_url: width: 1600 }}"{% endif %}>
      {%- if hv != blank and hv.sources.size > 0 -%}
        {%- for src in hv.sources -%}{%- if src.format == 'mp4' -%}<source src="{{ src.url }}" type="video/mp4">{%- endif -%}{%- endfor -%}
      {%- else -%}
        <source src="https://cdn.shopify.com/videos/c/vp/793b1b1551b44fa780fee83e10adf241/793b1b1551b44fa780fee83e10adf241.HD-720p-4.5Mbps-22536222.mp4" type="video/mp4">
      {%- endif -%}
    </video>
  </div>
  <div class="herotext" data-r>
    <div class="htag">Playa Venao &middot; Panama</div>
    <h1>World-Class Surf Lessons, Camps &amp; Foil Surfing in Playa Venao</h1>
    <p>Lessons, Camps, Foil Surfing, and More &mdash; all steps from the waves in Playa Venao.</p>
    <a href="/collections/surf-school-and-courses" class="btn pink">Book Now</a>
  </div>

  <!-- STATS -->
  <div class="sec"><div class="wrap">
    <div class="stats" data-rs>
      <div class="stat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M2 15c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2 2-2 4-2M2 20c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2 2-2 4-2"/></svg><div class="v">Playa Venao</div><div class="l">Panama &middot; Pacific coast</div></div>
      <div class="stat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.4 1.4M17.6 17.6L19 19M19 5l-1.4 1.4M6.4 17.6L5 19"/></svg><div class="v">All year</div><div class="l">Waves every season</div></div>
      <div class="stat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20v-5M10 20v-9M16 20v-13M20 20H3"/></svg><div class="v">All levels</div><div class="l">First wave to advanced</div></div>
      <div class="stat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2c4 3 5 10 2 18-1 2-3 2-4 0C7 12 8 5 12 2z"/><path d="M12 7v9"/></svg><div class="v">100+ Boards</div><div class="l">Every size on hand</div></div>
    </div>
  </div></div>

  <!-- INTRO -->
  <div class="sec tint"><div class="wrap" data-r>
    <div class="eyebrow-wrap"><span class="kicker">surf school</span></div>
    <h2>Your Panama Surf Adventure Awaits</h2>
    <p class="lead" style="margin-bottom:24px">Whether you&rsquo;re catching your very first wave or leveling up your surf skills, our experienced instructors have you covered. Choose from personalized surf lessons, immersive surf camps, foil surfing adventures, and engaging kids&rsquo; summer camps. With perfect waves, quality surfboard rentals, and our own Ocean Monkey soft-top boards, Shokogi is your ultimate Panama surf destination. Come join our vibrant surf community and experience the magic of Playa Venao!</p>
    <div style="text-align:center"><a href="/collections/surf-school-and-courses" class="btn pink">Join Us</a></div>
  </div></div>

  <!-- PROGRAMMES -->
  <div class="sec"><div class="wrap">
    <div data-r><div class="eyebrow-wrap"><span class="kicker">what we offer</span></div>
    <h2>Find Your Perfect Surf Experience</h2></div>
    <div class="pgm" style="margin-top:26px" data-rs>
      <a href="/collections/surf-school-and-courses" class="icard">
        {%- if section.settings.pgm_surf -%}{{ section.settings.pgm_surf | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', alt: 'Surf Lessons & Camps in Playa Venao' }}{%- endif -%}
        <div class="ib"><div class="k">Surf</div><h3>Surf Lessons &amp; Camps in Playa Venao</h3><p>Learn to surf or level up your skills with expert-led lessons and all-inclusive surf camps in Panama&rsquo;s top surf spot.</p><span class="more">Book now &rarr;</span></div>
      </a>
      <a href="/collections/foil-surfing" class="icard">
        {%- if section.settings.pgm_foil -%}{{ section.settings.pgm_foil | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', alt: 'Foil Surfing in Playa Venao' }}{%- endif -%}
        <div class="ib"><div class="k">Foil</div><h3>Foil Surfing in Playa Venao</h3><p>Discover the thrill of foil surfing in Panama. Book a private lesson and glide above the waves with our certified instructors.</p><span class="more">Fly now &rarr;</span></div>
      </a>
      <a href="/pages/custom-trips" class="icard">
        {%- if section.settings.pgm_trips -%}{{ section.settings.pgm_trips | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', alt: 'Custom Surf Trips in Playa Venao' }}{%- endif -%}
        <div class="ib"><div class="k">Custom Trips</div><h3>Custom Surf Trips in Playa Venao</h3><p>Choose your length of stay, pick your accommodations, and enjoy surf lessons and board rentals included. Perfectly tailored Panama surf packages for every traveler.</p><span class="more">Book now &rarr;</span></div>
      </a>
      <a href="/collections/kids-summer-camp-panama" class="icard">
        {%- if section.settings.pgm_kids -%}{{ section.settings.pgm_kids | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', alt: 'Kids Camp in Playa Venao' }}{%- endif -%}
        <div class="ib"><div class="k">Kids</div><h3>Kids Camp in Playa Venao</h3><p>Safe, fun, and skill-building surf camps for kids. Ideal for young kids and teens, with lessons, games, and ocean education.</p><span class="more">Book now &rarr;</span></div>
      </a>
    </div>
  </div></div>

  {%- render 'schome-rest', foil_video: section.settings.foil_video, rentals_image: section.settings.rentals_image -%}

</div>

<script src="{{ 'skplus.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Home Page",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Hero video" },
    { "type": "video", "id": "hero_video", "label": "Hero video" },
    { "type": "header", "content": "Foil video" },
    { "type": "video", "id": "foil_video", "label": "Foil video" },
    { "type": "header", "content": "Programme images" },
    { "type": "image_picker", "id": "pgm_surf", "label": "Surf" },
    { "type": "image_picker", "id": "pgm_foil", "label": "Foil" },
    { "type": "image_picker", "id": "pgm_trips", "label": "Custom Trips" },
    { "type": "image_picker", "id": "pgm_kids", "label": "Kids" },
    { "type": "header", "content": "Rentals" },
    { "type": "image_picker", "id": "rentals_image", "label": "Rentals image" }
  ],
  "presets": [ { "name": "Home Page" } ]
}
{% endschema %}
