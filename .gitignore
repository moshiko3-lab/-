__pycache__/
*.pyc

# built pages: rebuild them with build.py rather than committing 500 KB of
# generated markup on every change
app/index.html
app/booking.html
index.html
booking.html

# never commit credentials
.env
secrets/
*.enc
*.key

# real customers: names, phone numbers, email addresses. catalog.json is kept
# free of personal data on purpose; this file cannot be, so it never lands in
# the repository and the page built from it does not belong on a public URL.
app/clients.json
clients.json

# the crew's own WhatsApp numbers, for the same reason. The catalogue names
# the staff, which is fine; their mobile numbers are not, and the publish
# check refuses any build carrying them.
app/crew.json
crew.json

# the studio's own settings snapshot and cloud handle: both are written by
# the app rather than by hand. salon.json is meant to be committed once it
# has been exported; cloud.json holds only the publishable key, and is
# ignored so a half-filled one never ships by accident.
brows/cloud.json

# a signed-in Bloowatch browser: a secret, and never in the repo
session.json
*.session.json
