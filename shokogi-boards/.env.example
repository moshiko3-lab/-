# Copy to .env.local. Local development uses the local Supabase (`npx supabase start`, then `npx supabase status`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SECRET_KEY=

# Test logins that scripts/seed-local.mts creates, and the e2e tests use (local only, any values you like).
LOCAL_TEST_OWNER=owner@example.com
LOCAL_TEST_STAFF=dana
LOCAL_TEST_INSTRUCTOR=kai
LOCAL_TEST_PASSWORD=
# Any random strings locally. Production values live only in Vercel.
CRON_SECRET=
BLOOWATCH_WEBHOOK_SECRET=
# Google Sheets connect: the OAuth client of Google Cloud project "shokogi-boards". Locally any placeholder text
# is enough for the tests; real values are only needed to really connect a sheet.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
